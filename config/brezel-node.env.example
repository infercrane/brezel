# Internal node-relay process. The packaged single-host profile uses this path
# by default for command, file, and preview traffic.
BREZEL_NODE_LISTEN_ADDR=127.0.0.1:8443
BREZEL_NODE_CONTROL_LISTEN_ADDR=127.0.0.1:8444
BREZEL_NODE_ID=node-a
BREZEL_NODE_API_ID=api-a
BREZEL_NODE_CAPABILITY_AUDIENCE=brezel-node

# All trust and state paths must be clean absolute paths. Trust files must be
# regular, owned by the service user, mode 0400 or 0600, and have exactly one
# hard link.
BREZEL_NODE_CAPABILITY_KEYS_FILE=/etc/brezel/node/capability-keys.json
BREZEL_NODE_TLS_CERT_FILE=/etc/brezel/node/node.crt
BREZEL_NODE_TLS_KEY_FILE=/etc/brezel/node/node.key
BREZEL_NODE_TLS_CA_FILE=/etc/brezel/node/ca.crt
BREZEL_NODE_LEDGER_FILE=/var/lib/brezel/node/routes.json
BREZEL_ENGINE_TOKEN_FILE=/var/lib/brezel/secrets/engine.token

BREZEL_ENGINE_API_URL=http://127.0.0.1:3000
BREZEL_GUEST_URL_TEMPLATE=http://127.0.0.1:5007
BREZEL_DURABLE_WORKSPACES=false
BREZEL_NODE_REPLAY_CAPACITY=65536
BREZEL_NODE_MAX_IN_FLIGHT=64
BREZEL_NODE_DRAIN_TIMEOUT=5m
