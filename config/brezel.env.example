# The default distribution starts the Firecracker engine locally. Its
# installer writes a generated, host-local credential to this protected file.
# No E2B account or managed endpoint is required.
BREZEL_ENGINE_API_URL=http://127.0.0.1:3000
BREZEL_ENGINE_TOKEN_FILE=./.brezel/secrets/engine.token
BREZEL_GUEST_URL_TEMPLATE=http://127.0.0.1:5007
# Advertise workspaces only when the engine has a qualified durable-volume
# configuration. The bundled installer enables and verifies this path.
BREZEL_DURABLE_WORKSPACES=false

BREZEL_LISTEN_ADDR=127.0.0.1:8080
BREZEL_DATA_FILE=./.brezel/state/state.json
# Production policy file contains SHA-256 token digests bound to explicit
# projects. It must be a private regular file. Trusted-operator mode is an
# isolated-development escape hatch and is mutually exclusive with the policy.
BREZEL_ACCESS_POLICY_FILE=./.brezel/secrets/access-policy.json
BREZEL_TRUSTED_OPERATOR_MODE=false
BREZEL_SERVICE_TOKEN_FILE=./.brezel/secrets/service.token
BREZEL_RECEIPT_PRIVATE_KEY_FILE=./.brezel/secrets/receipt.key
BREZEL_MAX_ACTIVE_SANDBOXES_PER_PROJECT=64
BREZEL_MAX_WORKSPACES_PER_PROJECT=64
BREZEL_MAX_CONCURRENT_GUEST_OPS_PER_PROJECT=128
BREZEL_MAX_ENVIRONMENTS_PER_PROJECT=256
BREZEL_MAX_CONNECTORS_PER_PROJECT=256
BREZEL_MAX_IN_FLIGHT_REQUESTS=512

# Optional preview credential broker. Configure both or neither. Secret files
# must be regular files with mode 0400 or 0600 and are addressed as
# secret://file/NAME.
# BREZEL_CONNECTOR_GATEWAY_URL=https://brezel.example.com/connector/v1
# BREZEL_SECRET_FILE_DIR=/var/lib/brezel/secrets
