# The default distribution starts the Firecracker engine locally. Its
# installer writes a generated, host-local credential to this protected file.
# No E2B account or managed endpoint is required.
RUNTIME_ENGINE_API_URL=http://127.0.0.1:3000
RUNTIME_ENGINE_TOKEN_FILE=./runtime-state/engine.token
RUNTIME_GUEST_URL_TEMPLATE=http://127.0.0.1:3002
# Advertise workspaces only when the engine has a qualified durable-volume
# configuration. The bundled installer enables and verifies this path.
RUNTIME_DURABLE_WORKSPACES=false

RUNTIME_LISTEN_ADDR=127.0.0.1:8080
RUNTIME_DATA_FILE=./runtime-state/state.json
# Production policy file contains SHA-256 token digests bound to explicit
# projects. It must be a private regular file. Trusted-operator mode is an
# isolated-development escape hatch and is mutually exclusive with the policy.
RUNTIME_ACCESS_POLICY_FILE=./runtime-state/access-policy.json
RUNTIME_TRUSTED_OPERATOR_MODE=false
RUNTIME_SERVICE_TOKEN_FILE=./runtime-state/service.token
RUNTIME_RECEIPT_PRIVATE_KEY_FILE=./runtime-state/receipt.key
RUNTIME_MAX_ACTIVE_SANDBOXES_PER_PROJECT=64
RUNTIME_MAX_WORKSPACES_PER_PROJECT=64
RUNTIME_MAX_CONCURRENT_GUEST_OPS_PER_PROJECT=128
RUNTIME_MAX_ENVIRONMENTS_PER_PROJECT=256
RUNTIME_MAX_CONNECTORS_PER_PROJECT=256
RUNTIME_MAX_IN_FLIGHT_REQUESTS=512

# Optional preview credential broker. Configure both or neither. Secret files
# must be regular files with mode 0600 and are addressed as secret://file/NAME.
# RUNTIME_CONNECTOR_GATEWAY_URL=https://runtime.example.com/connector/v1
# RUNTIME_SECRET_FILE_DIR=/var/lib/runtime/secrets
