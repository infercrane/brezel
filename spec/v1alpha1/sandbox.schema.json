{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox.runtime.dev/spec/v1alpha1/sandbox.schema.json",
  "title": "Create sandbox",
  "description": "Request body accepted by POST /v1/sandboxes. Exactly one immutable environment revision or filesystem checkpoint is required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifecycle", "network"],
  "properties": {
    "environment_revision": {
      "type": "string",
      "pattern": "^envr_[a-f0-9]{64}$",
      "maxLength": 69
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^chk_[a-f0-9]{32}$",
      "maxLength": 36
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_after_seconds"],
      "properties": {
        "standby_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2591999,
          "default": 0
        },
        "standby_grace_seconds": {
          "description": "Additional inactivity grace before the runtime initiates standby. Zero uses the runtime default when standby is enabled.",
          "type": "integer",
          "minimum": 0,
          "maximum": 300,
          "default": 0
        },
        "expires_after_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 2592000
        },
        "standby_checkpoint_kind": {
          "enum": ["filesystem", "full_state"],
          "default": "full_state"
        },
        "auto_resume": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "auto_resume": { "const": true } },
            "required": ["auto_resume"]
          },
          "then": {
            "required": ["standby_after_seconds", "standby_checkpoint_kind"],
            "properties": {
              "standby_after_seconds": { "minimum": 1 },
              "standby_checkpoint_kind": { "const": "full_state" }
            }
          }
        },
        {
          "if": {
            "properties": { "standby_grace_seconds": { "minimum": 1 } },
            "required": ["standby_grace_seconds"]
          },
          "then": {
            "required": ["standby_after_seconds"],
            "properties": { "standby_after_seconds": { "minimum": 1 } }
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_internet"],
      "properties": {
        "allow_internet": { "type": "boolean", "default": false },
        "allow_out": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "maxItems": 128,
          "uniqueItems": true
        },
        "deny_out": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "maxItems": 128,
          "uniqueItems": true
        }
      }
    },
    "connector_revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^connr_[a-f0-9]{64}$",
        "maxLength": 70
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "workspace_mounts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspace_id", "path"],
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^wrk_[a-f0-9]{32}$",
            "maxLength": 36
          },
          "path": {
            "type": "string",
            "description": "A clean absolute path below root. The API also rejects dot segments, duplicate paths, and root itself.",
            "pattern": "^/[^\\u0000]{1,4095}$",
            "maxLength": 4096
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["environment_revision"],
      "not": { "required": ["checkpoint_id"] }
    },
    {
      "required": ["checkpoint_id"],
      "not": { "required": ["environment_revision"] }
    }
  ]
}
