{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime.dev/spec/v1alpha1/access-policy.schema.json",
  "title": "Runtime access policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "principals"],
  "properties": {
    "version": {
      "const": 1
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "token_sha256", "projects"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
            }
          }
        }
      }
    }
  }
}
