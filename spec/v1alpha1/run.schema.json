{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox.runtime.dev/spec/v1alpha1/run.schema.json",
  "title": "Open Agent Runtime Job Run",
  "description": "A bounded, immutable job attempt. Interactive sessions use the Sandbox contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "sandbox.runtime.dev/v1alpha1" },
    "kind": { "const": "Run" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 128 },
          "maxProperties": 32
        }
      }
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "capabilities", "timeoutSeconds", "receipt"],
      "description": "The environment map is non-secret configuration. Credentials are available only through immutable connector revisions.",
      "properties": {
        "environmentRevision": {
          "type": "string",
          "pattern": "^environment://[a-z0-9]([-a-z0-9]*[a-z0-9])?@sha256:[a-f0-9]{64}$",
          "maxLength": 1024
        },
        "checkpointRevision": {
          "type": "string",
          "pattern": "^checkpoint://[a-z0-9]([-a-z0-9]*[a-z0-9])?@sha256:[a-f0-9]{64}$",
          "maxLength": 1024
        },
        "image": {
          "type": "string",
          "description": "Immutable OCI shorthand from which an environment is resolved.",
          "pattern": "^.+@sha256:[a-f0-9]{64}$",
          "maxLength": 1024
        },
        "command": {
          "type": "array",
          "items": { "type": "string", "maxLength": 8192 },
          "minItems": 1,
          "maxItems": 256
        },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string", "maxLength": 8192 },
          "maxProperties": 128
        },
        "inputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "destination", "access"],
            "properties": {
              "source": { "type": "string", "pattern": "^artifact://sha256:[a-f0-9]{64}$" },
              "destination": { "$ref": "#/$defs/absolutePath" },
              "access": { "enum": ["read", "cow"] }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesystem", "network"],
          "properties": {
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "required": ["read", "write"],
              "properties": {
                "read": { "type": "array", "items": { "$ref": "#/$defs/absolutePath" }, "uniqueItems": true, "maxItems": 128 },
                "write": { "type": "array", "items": { "$ref": "#/$defs/absolutePath" }, "uniqueItems": true, "maxItems": 128 }
              }
            },
            "network": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["deny", "allowlist"] },
                "allow": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["host", "port"],
                    "properties": {
                      "host": { "type": "string", "format": "hostname", "maxLength": 253 },
                      "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "methods": {
                        "type": "array",
                        "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
                        "uniqueItems": true
                      },
                      "pathPrefixes": {
                        "type": "array",
                        "items": { "type": "string", "pattern": "^/", "maxLength": 2048 },
                        "uniqueItems": true
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "mode": { "const": "deny" } } },
                  "then": { "not": { "required": ["allow"] } }
                },
                {
                  "if": { "properties": { "mode": { "const": "allowlist" } } },
                  "then": { "required": ["allow"], "properties": { "allow": { "minItems": 1 } } }
                }
              ]
            },
            "connectors": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "revision"],
                "properties": {
                  "alias": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
                  "revision": {
                    "type": "string",
                    "pattern": "^connector://[a-z0-9]([-a-z0-9]*[a-z0-9])?@sha256:[a-f0-9]{64}$",
                    "maxLength": 1024
                  }
                }
              }
            },
            "devices": {
              "type": "array",
              "items": { "type": "string", "maxLength": 256 },
              "maxItems": 16,
              "uniqueItems": true
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
            "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$" },
            "pids": { "type": "integer", "minimum": 1, "maximum": 65536 }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "outputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/absolutePath" },
              "required": { "type": "boolean", "default": true },
              "maxBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
            }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumAssurance", "includeContent"],
          "properties": {
            "minimumAssurance": { "enum": ["observed", "enforced", "attested"] },
            "includeCommandDigests": { "type": "boolean", "default": true },
            "includeContent": { "const": false }
          }
        }
      },
      "oneOf": [
        { "required": ["environmentRevision"], "not": { "anyOf": [{ "required": ["checkpointRevision"] }, { "required": ["image"] }] } },
        { "required": ["checkpointRevision"], "not": { "anyOf": [{ "required": ["environmentRevision"] }, { "required": ["image"] }] } },
        { "required": ["image"], "not": { "anyOf": [{ "required": ["environmentRevision"] }, { "required": ["checkpointRevision"] }] } }
      ]
    }
  }
}
