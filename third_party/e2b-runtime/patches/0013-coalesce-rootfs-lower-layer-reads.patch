+	got := <-result
+	require.NoError(t, got.err)
+	require.Equal(t, len(got.data), got.n)
+	require.Equal(t, want, got.data)
+	require.EqualValues(t, 2, base.calls.Load(), "release must invalidate and retry the optimistic read")
+}
+
+func TestOverlayCoalescedBaseReadRetriesAfterConcurrentFoldSealing(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	readSize := int64(32) * blockSize
+	size := 2 * readSize
+	baseData := fill(size, 0x42)
+	base := &blockingOriginalDevice{
+		fakeOriginalDevice: fakeOriginalDevice{data: baseData},
+		started:            make(chan struct{}),
+		release:            make(chan struct{}),
+	}
+	initial, err := NewCache(size, blockSize, t.TempDir()+"/initial", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, initial)
+	foldedData := fill(readSize, 0xA7)
+	_, err = overlay.WriteAt(foldedData, readSize)
+	require.NoError(t, err)
+	fresh, err := NewCache(size, blockSize, t.TempDir()+"/fresh", false)
+	require.NoError(t, err)
+	_, err = overlay.SwapCache(fresh)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_ = initial.Close()
+		_ = overlay.Close()
+	})
+
+	result := startOverlayRead(t, overlay, readSize)
+	<-base.started
+	folded, err := overlay.FoldSealing()
+	require.NoError(t, err)
+	require.Same(t, initial, folded, "fold must finish while lower-source I/O is blocked")
+	close(base.release)
+
+	got := <-result
+	require.NoError(t, got.err)
+	require.Equal(t, len(got.data), got.n)
+	require.Equal(t, baseData[:readSize], got.data)
+	require.EqualValues(t, 2, base.calls.Load(), "fold must invalidate and retry the optimistic read")
+
+	gotFolded := make([]byte, readSize)
+	n, err := overlay.ReadAt(t.Context(), gotFolded, readSize)
+	require.NoError(t, err)
+	require.Equal(t, len(gotFolded), n)
+	require.Equal(t, foldedData, gotFolded, "folded sealing bytes must remain visible in the writable cache")
+}
