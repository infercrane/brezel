+//go:build linux
+
+package block
+
+import (
+	"context"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+type blockingOriginalDevice struct {
+	fakeOriginalDevice
+
+	started chan struct{}
+	release chan struct{}
+	once    sync.Once
+	calls   atomic.Int64
+}
+
+type blockingHeaderOriginalDevice struct {
+	fakeOriginalDevice
+
+	started  chan struct{}
+	release  chan struct{}
+	once     sync.Once
+	calls    atomic.Int64
+	mu       sync.RWMutex
+	nextData []byte
+}
+
+func (d *blockingHeaderOriginalDevice) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	d.mu.RLock()
+	if off >= int64(len(d.data)) {
+		d.mu.RUnlock()
+
+		return 0, io.EOF
+	}
+	snapshot := append([]byte(nil), d.data[off:]...)
+	d.mu.RUnlock()
+
+	d.calls.Add(1)
+	d.once.Do(func() { close(d.started) })
+	select {
+	case <-d.release:
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+
+	n := copy(p, snapshot)
+	if n < len(p) {
+		return n, io.EOF
+	}
+
+	return n, nil
+}
+
+func (d *blockingHeaderOriginalDevice) Header() *header.Header {
+	d.mu.RLock()
+	defer d.mu.RUnlock()
+
+	return d.hdr
+}
+
+func (d *blockingHeaderOriginalDevice) SwapHeader(h *header.Header) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	d.hdr = h
+	d.data = d.nextData
+}
+
+type overlayReadResult struct {
+	data []byte
+	n    int
+	err  error
+}
+
+func startOverlayRead(t *testing.T, overlay *Overlay, size int64) <-chan overlayReadResult {
+	t.Helper()
+
+	result := make(chan overlayReadResult, 1)
+	go func() {
+		data := make([]byte, size)
+		n, err := overlay.ReadAt(t.Context(), data, 0)
+		result <- overlayReadResult{data: data, n: n, err: err}
+	}()
+
+	return result
+}
+
+func (d *blockingOriginalDevice) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	d.calls.Add(1)
+	d.once.Do(func() { close(d.started) })
+	select {
+	case <-d.release:
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+
+	return copy(p, d.data[off:]), nil
+}
+
+func TestOverlayReadAtCoalescesSealingRange(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	size := int64(32) * blockSize
+	base := &fakeOriginalDevice{data: fill(size, 0x11)}
+	sealing, err := NewCache(size, blockSize, t.TempDir()+"/sealing", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, sealing)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	want := fill(size, 0xA5)
+	_, err = overlay.WriteAt(want, 0)
+	require.NoError(t, err)
+	fresh, err := NewCache(size, blockSize, t.TempDir()+"/fresh", false)
+	require.NoError(t, err)
+	_, err = overlay.SwapCache(fresh)
+	require.NoError(t, err)
+
+	got := make([]byte, size)
+	n, err := overlay.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	require.Equal(t, len(got), n)
+	require.Equal(t, want, got)
+	require.Zero(t, base.reads, "an all-sealing range must not reach the base")
+}
+
+func TestOverlayCoalescedBaseReadRetriesAfterConcurrentWrite(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	size := int64(32) * blockSize
+	base := &blockingOriginalDevice{
+		fakeOriginalDevice: fakeOriginalDevice{data: fill(size, 0x11)},
+		started:            make(chan struct{}),
+		release:            make(chan struct{}),
+	}
+	cache, err := NewCache(size, blockSize, t.TempDir()+"/cache", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, cache)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	type readResult struct {
+		data []byte
+		n    int
+		err  error
+	}
+	result := make(chan readResult, 1)
+	go func() {
+		data := make([]byte, size)
+		n, err := overlay.ReadAt(t.Context(), data, 0)
+		result <- readResult{data: data, n: n, err: err}
+	}()
+
+	<-base.started
+	want := fill(size, 0xA5)
+	_, err = overlay.WriteAt(want, 0)
+	require.NoError(t, err, "writes must not wait for lower-source I/O")
+	close(base.release)
+
+	got := <-result
+	require.NoError(t, got.err)
+	require.Equal(t, len(got.data), got.n)
+	require.Equal(t, want, got.data, "a completed concurrent write must invalidate stale base bytes")
+	require.EqualValues(t, 1, base.calls.Load(), "the retry should resolve from the writable cache")
+}
+
+func TestOverlayCoalescedBaseReadRetriesAfterConcurrentSwapAndWrite(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	size := int64(32) * blockSize
+	base := &blockingOriginalDevice{
+		fakeOriginalDevice: fakeOriginalDevice{data: fill(size, 0x11)},
+		started:            make(chan struct{}),
+		release:            make(chan struct{}),
+	}
+	initial, err := NewCache(size, blockSize, t.TempDir()+"/initial", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, initial)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	type readResult struct {
+		data []byte
+		n    int
+		err  error
+	}
+	result := make(chan readResult, 1)
+	go func() {
+		data := make([]byte, size)
+		n, err := overlay.ReadAt(t.Context(), data, 0)
+		result <- readResult{data: data, n: n, err: err}
+	}()
+
+	<-base.started
+	fresh, err := NewCache(size, blockSize, t.TempDir()+"/fresh", false)
+	require.NoError(t, err)
+	_, err = overlay.SwapCache(fresh)
+	require.NoError(t, err)
+	want := fill(size, 0xB6)
+	_, err = overlay.WriteAt(want, 0)
+	require.NoError(t, err)
+	close(base.release)
+
+	got := <-result
+	require.NoError(t, got.err)
+	require.Equal(t, len(got.data), got.n)
+	require.Equal(t, want, got.data)
+	require.EqualValues(t, 1, base.calls.Load())
+}
+
+func TestOverlayMutationStateTracksOverlappingWriters(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	base := &fakeOriginalDevice{data: make([]byte, blockSize)}
+	cache, err := NewCache(blockSize, blockSize, t.TempDir()+"/cache", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, cache)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	overlay.beginMutation()
+	overlay.beginMutation()
+	require.EqualValues(t, 2, uint32(overlay.mutationState.Load()))
+	require.False(t, mutationQuiescent(overlay.mutationState.Load()))
+	overlay.endMutation()
+	require.EqualValues(t, 1, uint32(overlay.mutationState.Load()))
+	require.False(t, mutationQuiescent(overlay.mutationState.Load()))
+	overlay.endMutation()
+	require.True(t, mutationQuiescent(overlay.mutationState.Load()))
+}
+
+func TestOverlayCoalescedBaseReadRetriesAfterConcurrentReleaseSealing(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	size := int64(32) * blockSize
+	want := fill(size, 0x31)
+	base := &blockingOriginalDevice{
+		fakeOriginalDevice: fakeOriginalDevice{data: want},
+		started:            make(chan struct{}),
+		release:            make(chan struct{}),
+	}
+	initial, err := NewCache(size, blockSize, t.TempDir()+"/initial", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, initial)
+	fresh, err := NewCache(size, blockSize, t.TempDir()+"/fresh", false)
+	require.NoError(t, err)
+	_, err = overlay.SwapCache(fresh)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_ = initial.Close()
+		_ = overlay.Close()
+	})
