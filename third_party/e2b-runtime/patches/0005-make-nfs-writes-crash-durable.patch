+func TestWrappedFile_WriteSyncsBeforeSuccess(t *testing.T) {
+	t.Parallel()
+
+	file, err := os.CreateTemp(t.TempDir(), "write-sync")
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, file.Close()) })
+
+	syncCalls := 0
+	w := &wrappedFile{
+		file: file,
+		syncFn: func() error {
+			syncCalls++
+
+			return nil
+		},
+	}
+
+	n, err := w.Write([]byte("durable"))
+	require.NoError(t, err)
+	assert.Equal(t, len("durable"), n)
+	assert.Equal(t, 1, syncCalls)
+}
+
+func TestWrappedFile_WriteRejectsFailedSync(t *testing.T) {
+	t.Parallel()
+
+	file, err := os.CreateTemp(t.TempDir(), "write-sync-failure")
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, file.Close()) })
+
+	errSync := errors.New("injected sync failure")
+	w := &wrappedFile{file: file, syncFn: func() error { return errSync }}
+
+	n, writeErr := w.Write([]byte("not acknowledged"))
+	assert.Equal(t, len("not acknowledged"), n)
+	assert.ErrorIs(t, writeErr, errSync)
+}
+
+func TestWrappedFile_TruncateRejectsFailedSync(t *testing.T) {
+	t.Parallel()
+
+	file, err := os.CreateTemp(t.TempDir(), "truncate-sync-failure")
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, file.Close()) })
+
+	errSync := errors.New("injected sync failure")
+	w := &wrappedFile{file: file, syncFn: func() error { return errSync }}
+
+	assert.ErrorIs(t, w.Truncate(4), errSync)
+}
