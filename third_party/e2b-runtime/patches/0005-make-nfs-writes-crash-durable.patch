+
+// syncMetadata flushes regular files and directories directly. Other inode
+// types (including a no-follow symlink update) cannot be portably opened for
+// fsync, so flush the containing directory that owns their metadata instead.
+func syncMetadata(fs *chrooted.Chrooted, name string, follow bool) error {
+	var (
+		info os.FileInfo
+		err  error
+	)
+	if follow {
+		info, err = fs.Stat(name)
+	} else {
+		info, err = fs.Lstat(name)
+	}
+	if err != nil {
+		return err
+	}
+
+	if info.Mode().IsRegular() || info.IsDir() {
+		return syncPath(fs, name)
+	}
+
+	return syncParent(fs, name)
+}
diff --git a/packages/orchestrator/pkg/nfsproxy/chroot/durability_test.go b/packages/orchestrator/pkg/nfsproxy/chroot/durability_test.go
new file mode 100644
index 00000000..94f19ac7
--- /dev/null
+++ b/packages/orchestrator/pkg/nfsproxy/chroot/durability_test.go
@@ -0,0 +1,62 @@
+//go:build linux
+
+package chroot
+
+import (
+	"os"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/chrooted"
+)
+
+func TestWrappedFSMutationsPassDurabilityBoundary(t *testing.T) {
+	t.Parallel()
+
+	root := t.TempDir()
+	confined, err := chrooted.Chroot(root)
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, confined.Close()) })
+	fs := wrapChrooted(confined)
+
+	file, err := fs.Create("/from")
+	require.NoError(t, err)
+	require.NoError(t, file.Close())
+	require.NoError(t, fs.Rename("/from", "/to"))
+	require.NoError(t, fs.Remove("/to"))
+
+	require.NoError(t, fs.MkdirAll("/parent/child", 0o700))
+	require.NoError(t, fs.Symlink("/target", "/parent/link"))
+	require.NoError(t, fs.Remove("/parent/link"))
+
+	temporary, err := fs.TempFile("/parent", "temporary-")
+	require.NoError(t, err)
+	temporaryName := temporary.Name()
+	require.NoError(t, temporary.Close())
+	require.NoError(t, fs.Remove(temporaryName))
+}
+
+func TestWrappedChangePassesDurabilityBoundary(t *testing.T) {
+	t.Parallel()
+
+	confined, err := chrooted.Chroot(t.TempDir())
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, confined.Close()) })
+	fs := wrapChrooted(confined)
+	change := wrapChange(confined)
+
+	file, err := fs.Create("/metadata")
+	require.NoError(t, err)
+	require.NoError(t, file.Close())
+	require.NoError(t, change.Chmod("/metadata", 0o600))
+	require.NoError(t, change.Chown("/metadata", os.Getuid(), os.Getgid()))
+	require.NoError(t, change.Lchown("/metadata", os.Getuid(), os.Getgid()))
+	now := time.Now().Add(-time.Minute)
+	require.NoError(t, change.Chtimes("/metadata", now, now))
+
+	require.NoError(t, fs.Symlink("/missing", "/dangling"))
+	require.NoError(t, change.Lchown("/dangling", os.Getuid(), os.Getgid()))
+}
