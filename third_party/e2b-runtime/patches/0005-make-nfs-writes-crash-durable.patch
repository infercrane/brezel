+
+// syncPath flushes one regular file or directory through a confined
+// descriptor. The path reported in an error remains the guest-visible path;
+// the backing host path never crosses the NFS boundary.
+func syncPath(fs *chrooted.Chrooted, name string) error {
+	file, err := fs.Open(name)
+	if err != nil {
+		return err
+	}
+
+	return errors.Join(file.Sync(), file.Close())
+}
+
+func syncParent(fs *chrooted.Chrooted, name string) error {
+	return syncPath(fs, path.Dir(name))
+}
+
+func syncDirectoryTree(fs *chrooted.Chrooted, name string) error {
+	dir := path.Clean(name)
+	for {
+		if err := syncPath(fs, dir); err != nil {
+			return err
+		}
+		if dir == "/" || dir == "." {
+			return nil
+		}
+
+		dir = path.Dir(dir)
+	}
+}
