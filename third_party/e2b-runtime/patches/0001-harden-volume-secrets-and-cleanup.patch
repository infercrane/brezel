@@ -301,3 +294,54 @@ func Parse() (Config, error) {
 
 	return config, nil
 }
+
+func parseJWTSigningKey(v string) (any, error) {
+	keyPieces := strings.SplitN(strings.TrimSpace(v), ":", 2)
+	if len(keyPieces) != 2 {
+		return nil, ErrInvalidJWTSigningKey
+	}
+	keyType := keyPieces[0]
+	keyValue, err := base64.StdEncoding.DecodeString(keyPieces[1])
+	if err != nil {
+		return nil, errors.New("JWT signing key must be base64 encoded")
+	}
+	switch strings.ToUpper(keyType) {
+	case "ECDSA":
+		return jwt.ParseECPrivateKeyFromPEM(keyValue)
+	case "RSA":
+		return jwt.ParseRSAPrivateKeyFromPEM(keyValue)
+	case "HMAC":
+		return keyValue, nil
+	case "ED25519":
+		return jwt.ParseEdPrivateKeyFromPEM(keyValue)
+	default:
+		return nil, fmt.Errorf("%s: %w", keyType, ErrUnknownKeyType)
+	}
+}
+
+func readPrivateSigningKeyFile(path string) (string, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return "", fmt.Errorf("read volume token signing key: %w", err)
+	}
+	if !info.Mode().IsRegular() || info.Mode().Perm()&0o077 != 0 {
+		return "", errors.New("volume token signing key file must be a private regular file")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return "", fmt.Errorf("open volume token signing key: %w", err)
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, (16<<10)+1))
+	if err != nil {
+		return "", fmt.Errorf("read volume token signing key: %w", err)
+	}
+	if len(data) > 16<<10 {
+		return "", errors.New("volume token signing key file exceeds 16384 bytes")
+	}
+	value := strings.TrimSpace(string(data))
+	if value == "" || strings.ContainsAny(value, "\r\n") {
+		return "", errors.New("volume token signing key file is empty or malformed")
+	}
+	return value, nil
+}
