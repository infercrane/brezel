diff --git a/packages/orchestrator/pkg/sandbox/nbd/path_direct_lifecycle_test.go b/packages/orchestrator/pkg/sandbox/nbd/path_direct_lifecycle_test.go
new file mode 100644
index 0000000..c53fdc5
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/nbd/path_direct_lifecycle_test.go
@@ -0,0 +1,302 @@
+//go:build linux
+
+package nbd
+
+import (
+	"context"
+	"errors"
+	"math"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/Merovius/nbd/nbdnl"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/nbd/testutils"
+	"github.com/e2b-dev/infra/packages/shared/pkg/featureflags"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+var (
+	errInjectedSocketPair = errors.New("injected socketpair failure")
+	errInjectedFileConn   = errors.New("injected FileConn failure")
+	errInjectedConnect    = errors.New("injected connect failure")
+)
+
+type lifecycleDevice struct {
+	*testutils.ZeroDevice
+}
+
+func (d *lifecycleDevice) WriteAt(p []byte, _ int64) (int, error) {
+	return len(p), nil
+}
+
+func (d *lifecycleDevice) WriteZeroesAt(_, length int64) (int, error) {
+	return int(length), nil
+}
+
+func newLifecycleMount(t *testing.T, connections int) *DirectPathMount {
+	t.Helper()
+
+	device, err := testutils.NewZeroDevice(16*1024*1024, header.RootfsBlockSize)
+	require.NoError(t, err)
+
+	mnt := NewDirectPathMount(
+		&lifecycleDevice{ZeroDevice: device},
+		nil,
+		&featureflags.Client{},
+		WithConnectionsPerDevice(connections),
+	)
+	// Unit tests exercise the lifecycle without requiring an NBD module. Every
+	// kernel/pool boundary is still represented and counted explicitly.
+	mnt.ops.openDevice = func(string) (*os.File, error) { return nil, nil }
+	mnt.ops.status = func(idx uint32) (nbdnl.DeviceStatus, error) {
+		return nbdnl.DeviceStatus{Index: idx, Connected: true}, nil
+	}
+	mnt.ops.disconnect = func(context.Context, uint32, time.Duration) error { return nil }
+
+	return mnt
+}
+
+func realSocketPair() ([2]int, error) {
+	return syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+}
+
+func requireFDClosed(t *testing.T, fd int) {
+	t.Helper()
+
+	_, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0)
+	require.ErrorIs(t, err, unix.EBADF, "fd %d remains open", fd)
+}
+
+func TestDirectPathMountPartialSocketCreationCleansAttempt(t *testing.T) {
+	mnt := newLifecycleMount(t, 3)
+
+	var acquired, released atomic.Int32
+	mnt.ops.getDevice = func(context.Context) (uint32, error) {
+		acquired.Add(1)
+		return 11, nil
+	}
+	mnt.ops.releaseDevice = func(context.Context, uint32, ...ReleaseOption) error {
+		released.Add(1)
+		return nil
+	}
+
+	var calls int
+	var created [][2]int
+	mnt.ops.socketPair = func() ([2]int, error) {
+		calls++
+		if calls == 2 {
+			return [2]int{}, errInjectedSocketPair
+		}
+		pair, err := realSocketPair()
+		if err == nil {
+			created = append(created, pair)
+		}
+		return pair, err
+	}
+	mnt.ops.connect = func(uint32, []*os.File, uint64, nbdnl.ClientFlags, nbdnl.ServerFlags, ...nbdnl.ConnectOption) (uint32, error) {
+		t.Fatal("Connect called after partial socket creation failure")
+		return 0, nil
+	}
+
+	idx, err := mnt.Open(t.Context())
+	require.ErrorIs(t, err, errInjectedSocketPair)
+	require.Equal(t, uint32(math.MaxUint32), idx)
+	require.EqualValues(t, 1, acquired.Load())
+	require.EqualValues(t, 1, released.Load())
+	for _, pair := range created {
+		requireFDClosed(t, pair[0])
+		requireFDClosed(t, pair[1])
+	}
+	require.NoError(t, mnt.Close(t.Context()), "Close after failed Open must be harmless")
+}
+
+func TestDirectPathMountFileConnFailureCleansCurrentAndPriorPairs(t *testing.T) {
+	mnt := newLifecycleMount(t, 2)
+
+	var released atomic.Int32
+	mnt.ops.getDevice = func(context.Context) (uint32, error) { return 12, nil }
+	mnt.ops.releaseDevice = func(context.Context, uint32, ...ReleaseOption) error {
+		released.Add(1)
+		return nil
+	}
+
+	var created [][2]int
+	mnt.ops.socketPair = func() ([2]int, error) {
+		pair, err := realSocketPair()
+		if err == nil {
+			created = append(created, pair)
+		}
+		return pair, err
+	}
+	var fileConnCalls int
+	mnt.ops.fileConn = func(file *os.File) (net.Conn, error) {
+		fileConnCalls++
+		if fileConnCalls == 2 {
+			return nil, errInjectedFileConn
+		}
+		return net.FileConn(file)
+	}
+
+	idx, err := mnt.Open(t.Context())
+	require.ErrorIs(t, err, errInjectedFileConn)
+	require.Equal(t, uint32(math.MaxUint32), idx)
+	require.EqualValues(t, 1, released.Load())
+	for _, pair := range created {
+		requireFDClosed(t, pair[0])
+		requireFDClosed(t, pair[1])
+	}
+	require.NoError(t, mnt.Close(t.Context()))
+}
+
+func TestDirectPathMountConnectRetryFullyCleansPreviousAttempt(t *testing.T) {
+	mnt := newLifecycleMount(t, 4)
+
+	var getCalls atomic.Int32
+	mnt.ops.getDevice = func(context.Context) (uint32, error) {
+		return uint32(20 + getCalls.Add(1)), nil
+	}
+
+	var mu sync.Mutex
+	var released, disconnected []uint32
+	mnt.ops.releaseDevice = func(_ context.Context, idx uint32, _ ...ReleaseOption) error {
+		mu.Lock()
+		defer mu.Unlock()
+		released = append(released, idx)
+		return nil
+	}
+	mnt.ops.disconnect = func(_ context.Context, idx uint32, _ time.Duration) error {
+		mu.Lock()
+		defer mu.Unlock()
+		disconnected = append(disconnected, idx)
+		if idx == 21 {
+			return errors.New("not connected")
+		}
+		return nil
+	}
+
+	var connectCalls atomic.Int32
+	var firstAttemptClients []*os.File
+	mnt.ops.connect = func(idx uint32, socks []*os.File, _ uint64, _ nbdnl.ClientFlags, _ nbdnl.ServerFlags, _ ...nbdnl.ConnectOption) (uint32, error) {
+		call := connectCalls.Add(1)
+		require.Len(t, socks, 4)
+		if call == 1 {
+			firstAttemptClients = append(firstAttemptClients, socks...)
+			return 0, errInjectedConnect
+		}
+		for _, sock := range firstAttemptClients {
+			_, err := sock.Stat()
+			require.ErrorIs(t, err, os.ErrClosed, "previous-attempt client remains open")
+		}
+		return idx, nil
+	}
+
+	idx, err := mnt.Open(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, uint32(22), idx)
+	require.EqualValues(t, 2, connectCalls.Load())
+	require.NoError(t, mnt.Close(t.Context()))
+
+	mu.Lock()
+	defer mu.Unlock()
+	require.Equal(t, []uint32{21, 22}, released)
+	require.Equal(t, []uint32{21, 22}, disconnected)
+}
+
+func TestDirectPathMountCancellationAfterConnectCleansConnectedAttempt(t *testing.T) {
+	mnt := newLifecycleMount(t, 3)
+
+	var released, disconnected atomic.Int32
+	mnt.ops.getDevice = func(context.Context) (uint32, error) { return 31, nil }
+	mnt.ops.releaseDevice = func(context.Context, uint32, ...ReleaseOption) error {
+		released.Add(1)
+		return nil
+	}
+	mnt.ops.disconnect = func(context.Context, uint32, time.Duration) error {
+		disconnected.Add(1)
+		return nil
+	}
+	mnt.ops.connect = func(idx uint32, socks []*os.File, _ uint64, _ nbdnl.ClientFlags, _ nbdnl.ServerFlags, _ ...nbdnl.ConnectOption) (uint32, error) {
+		require.Len(t, socks, 3)
+		return idx, nil
+	}
+
+	ctx, cancel := context.WithCancel(t.Context())
+	mnt.afterConnect = func(uint32) { cancel() }
+
+	idx, err := mnt.Open(ctx)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Equal(t, uint32(math.MaxUint32), idx)
+	require.EqualValues(t, 1, released.Load())
+	require.EqualValues(t, 1, disconnected.Load())
+	require.NoError(t, mnt.Close(t.Context()))
+	require.EqualValues(t, 1, released.Load(), "idempotent Close released the slot again")
+}
+
+func TestDirectPathMountCloseIsSerializedAndIdempotent(t *testing.T) {
+	mnt := newLifecycleMount(t, 2)
+
+	var releases, disconnects atomic.Int32
+	mnt.ops.getDevice = func(context.Context) (uint32, error) { return 41, nil }
+	mnt.ops.releaseDevice = func(context.Context, uint32, ...ReleaseOption) error {
+		releases.Add(1)
+		return nil
+	}
+	mnt.ops.disconnect = func(context.Context, uint32, time.Duration) error {
+		disconnects.Add(1)
+		return nil
+	}
+	mnt.ops.connect = func(idx uint32, socks []*os.File, _ uint64, _ nbdnl.ClientFlags, _ nbdnl.ServerFlags, _ ...nbdnl.ConnectOption) (uint32, error) {
+		require.Len(t, socks, 2)
+		return idx, nil
+	}
+
+	_, err := mnt.Open(t.Context())
+	require.NoError(t, err)
+
+	const closers = 32
+	start := make(chan struct{})
+	errs := make(chan error, closers)
+	var wg sync.WaitGroup
+	for range closers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			errs <- mnt.Close(t.Context())
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+
+	require.EqualValues(t, 1, disconnects.Load())
+	require.EqualValues(t, 1, releases.Load())
+}
+
+func TestDirectPathMountRejectsInvalidConnectionCountBeforeAcquisition(t *testing.T) {
+	for _, connections := range []int{0, 5} {
+		t.Run(string(rune('0'+connections)), func(t *testing.T) {
+			mnt := newLifecycleMount(t, connections)
+			mnt.ops.getDevice = func(context.Context) (uint32, error) {
+				t.Fatal("invalid count acquired a device")
+				return 0, nil
+			}
+
+			idx, err := mnt.Open(t.Context())
+			require.ErrorContains(t, err, "between 1 and 4")
+			require.Equal(t, uint32(math.MaxUint32), idx)
+			require.NoError(t, mnt.Close(t.Context()))
+		})
+	}
+}
