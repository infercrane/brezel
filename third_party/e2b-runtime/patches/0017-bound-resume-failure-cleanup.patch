+func TestProcessStopBeforeStartCleansArtifactsAndReturns(t *testing.T) {
+	t.Parallel()
+
+	metricsPath := filepath.Join(t.TempDir(), "metrics.fifo")
+	require.NoError(t, os.WriteFile(metricsPath, []byte("stale"), 0o600))
+
+	p := &Process{
+		cmd:         &exec.Cmd{},
+		Exit:        utils.NewErrorOnce(),
+		metricsPath: metricsPath,
+	}
+
+	ctx, cancel := context.WithTimeout(t.Context(), 100*time.Millisecond)
+	defer cancel()
+
+	require.NoError(t, p.Stop(ctx))
+	require.NoFileExists(t, metricsPath)
+	require.NoError(t, p.WaitForExit(ctx))
+}
+
+func TestProcessWaitForExitIsBoundedWhenWaiterStalls(t *testing.T) {
+	t.Parallel()
+
+	p := &Process{
+		cmd: &exec.Cmd{
+			// WaitForExit only uses Process as the started-state marker. The test
+			// does not signal or wait on this process handle.
+			Process: &os.Process{Pid: os.Getpid()},
+		},
+		Exit: utils.NewErrorOnce(),
+	}
+
+	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+	defer cancel()
+
+	err := p.WaitForExit(ctx)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+}
