+//go:build linux
+
+package block
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLocalReadAtPreservesBoundarySemantics(t *testing.T) {
+	t.Parallel()
+
+	path := t.TempDir() + "/base"
+	require.NoError(t, os.WriteFile(path, []byte("abcdefgh"), 0o600))
+	local, err := NewLocal(path, 4, uuid.New())
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, local.Close()) })
+
+	buf := []byte("XXXXXXXX")
+	n, err := local.ReadAt(t.Context(), buf, 4)
+	require.NoError(t, err)
+	require.Equal(t, 4, n)
+	require.Equal(t, []byte("efghXXXX"), buf)
+
+	n, err = local.ReadAt(t.Context(), buf, 8)
+	require.NoError(t, err)
+	require.Zero(t, n)
+
+	n, err = local.ReadAt(t.Context(), buf, -1)
+	require.ErrorContains(t, err, "failed to slice mmap")
+	require.Zero(t, n)
+}
+
+func BenchmarkLocalReadAt(b *testing.B) {
+	for _, size := range []int64{4 << 10, 128 << 10, 1 << 20} {
+		b.Run(fmt.Sprintf("%dKiB", size>>10), func(b *testing.B) {
+			path := b.TempDir() + "/base"
+			if err := os.WriteFile(path, make([]byte, size), 0o600); err != nil {
+				b.Fatal(err)
+			}
+			local, err := NewLocal(path, 4<<10, uuid.New())
+			if err != nil {
+				b.Fatal(err)
+			}
+			b.Cleanup(func() { _ = local.Close() })
+
+			buf := make([]byte, size)
+			ctx := context.Background()
+			b.SetBytes(size)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				if _, err := local.ReadAt(ctx, buf, 0); err != nil {
+					b.Fatal(err)
+				}
+			}
+			overlayReadBenchmarkSink = buf[len(buf)-1]
+		})
+	}
+}
