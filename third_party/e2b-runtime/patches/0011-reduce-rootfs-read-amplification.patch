index 0000000000000000000000000000000000000000..f31b7da2c1a3975ad61bacd522855e9159aa6a85
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/block/overlay_read_bench_test.go
@@ -0,0 +1,62 @@
+//go:build linux
+
+package block
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+var overlayReadBenchmarkSink byte
+
+func BenchmarkOverlayReadAt(b *testing.B) {
+	for _, size := range []int64{4 << 10, 128 << 10, 1 << 20} {
+		b.Run(fmt.Sprintf("all-writable/%dKiB", size>>10), func(b *testing.B) {
+			benchmarkOverlayReadAt(b, size, true)
+		})
+		b.Run(fmt.Sprintf("all-base/%dKiB", size>>10), func(b *testing.B) {
+			benchmarkOverlayReadAt(b, size, false)
+		})
+	}
+}
+
+func benchmarkOverlayReadAt(b *testing.B, size int64, writable bool) {
+	b.Helper()
+
+	base := &fakeOriginalDevice{data: make([]byte, size)}
+	cache, err := NewCache(size, int64(header.PageSize), b.TempDir()+"/cache", false)
+	if err != nil {
+		b.Fatal(err)
+	}
+	b.Cleanup(func() { _ = cache.Close() })
+
+	overlay := NewOverlay(base, cache)
+	if writable {
+		data := make([]byte, size)
+		for i := range data {
+			data[i] = byte(i)
+		}
+		if _, err := overlay.WriteAt(data, 0); err != nil {
+			b.Fatal(err)
+		}
+	}
+
+	buf := make([]byte, size)
+	ctx := context.Background()
+	base.reads = 0
+	b.SetBytes(size)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for range b.N {
+		if _, err := overlay.ReadAt(ctx, buf, 0); err != nil {
+			b.Fatal(err)
+		}
+	}
+	b.StopTimer()
+
+	b.ReportMetric(float64(base.reads)/float64(b.N), "base_reads/op")
+	overlayReadBenchmarkSink = buf[len(buf)-1]
+}
