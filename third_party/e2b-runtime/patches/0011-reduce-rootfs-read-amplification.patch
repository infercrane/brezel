@@ -0,0 +1,87 @@
+//go:build linux
+
+package block
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+func TestOverlayReadAtWholeWritableRange(t *testing.T) {
+	t.Parallel()
+
+	const blocks = int64(32)
+	blockSize := int64(header.PageSize)
+	size := blocks * blockSize
+	base := &fakeOriginalDevice{data: make([]byte, size)}
+	cache, err := NewCache(size, blockSize, t.TempDir()+"/cache", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, cache)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	want := make([]byte, size)
+	for i := range want {
+		want[i] = byte(i)
+	}
+	_, err = overlay.WriteAt(want, 0)
+	require.NoError(t, err)
+
+	got := make([]byte, size)
+	n, err := overlay.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	require.Equal(t, len(got), n)
+	require.Equal(t, want, got)
+	require.Zero(t, base.reads, "an all-writable read must not reach the base device")
+}
+
+func TestOverlayReadAtAllBaseRetainsBlockFallback(t *testing.T) {
+	t.Parallel()
+
+	const blocks = int64(32)
+	blockSize := int64(header.PageSize)
+	size := blocks * blockSize
+	want := make([]byte, size)
+	for i := range want {
+		want[i] = byte(i)
+	}
+	base := &fakeOriginalDevice{data: want}
+	cache, err := NewCache(size, blockSize, t.TempDir()+"/cache", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, cache)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	got := make([]byte, size)
+	n, err := overlay.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	require.Equal(t, len(got), n)
+	require.Equal(t, want, got)
+	require.EqualValues(t, blocks, base.reads, "base fallback remains block-granular")
+}
+
+func TestOverlayReadAtMixedWritableAndBaseBlocks(t *testing.T) {
+	t.Parallel()
+
+	blockSize := int64(header.PageSize)
+	size := 3 * blockSize
+	baseData := append(append(fill(blockSize, 0x10), fill(blockSize, 0x20)...), fill(blockSize, 0x30)...)
+	base := &fakeOriginalDevice{data: baseData}
+	cache, err := NewCache(size, blockSize, t.TempDir()+"/cache", false)
+	require.NoError(t, err)
+	overlay := NewOverlay(base, cache)
+	t.Cleanup(func() { require.NoError(t, overlay.Close()) })
+
+	_, err = overlay.WriteAt(fill(blockSize, 0xAA), blockSize)
+	require.NoError(t, err)
+
+	got := make([]byte, size)
+	n, err := overlay.ReadAt(t.Context(), got, 0)
+	require.NoError(t, err)
+	require.Equal(t, len(got), n)
+	require.Equal(t, fill(blockSize, 0x10), got[:blockSize])
+	require.Equal(t, fill(blockSize, 0xAA), got[blockSize:2*blockSize])
+	require.Equal(t, fill(blockSize, 0x30), got[2*blockSize:])
+	require.Equal(t, 2, base.reads)
+}
