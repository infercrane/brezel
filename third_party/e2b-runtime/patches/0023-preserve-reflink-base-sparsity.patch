+// materializeSparseReflinkContents copies the complete logical source and
+// computes its digest, but leaves an all-zero chunk as a hole in the new file.
+// basefd must refer to a newly created, empty file: skipping a write is safe
+// only because Ftruncate extends such a file with zero-filled sparse ranges.
+func materializeSparseReflinkContents(
+	ctx context.Context,
+	basefd int,
+	rootfs block.ReadonlyDevice,
+	expected reflinkManifest,
+) (string, error) {
+	var destinationStat unix.Stat_t
+	if err := unix.Fstat(basefd, &destinationStat); err != nil {
+		return "", err
+	}
+	if destinationStat.Mode&unix.S_IFMT != unix.S_IFREG || destinationStat.Size != 0 {
+		return "", errors.New("sparse reflink destination must be an empty regular file")
+	}
+	if err := unix.Ftruncate(basefd, expected.DiskSize); err != nil {
+		return "", err
+	}
+	chunkSize := directMaterializeChunkBytes
+	if expected.BlockSize > chunkSize {
+		chunkSize = expected.BlockSize
+	} else {
+		chunkSize -= chunkSize % expected.BlockSize
+	}
+	buffer := make([]byte, chunkSize)
+	zeroes := make([]byte, chunkSize)
+	hash := sha256.New()
+	for offset := int64(0); offset < expected.DiskSize; offset += chunkSize {
+		if err := ctx.Err(); err != nil {
+			return "", err
+		}
+		length := min(chunkSize, expected.DiskSize-offset)
+		count, err := rootfs.ReadAt(ctx, buffer[:length], offset)
+		if err != nil {
+			return "", fmt.Errorf("reading reflink base at offset %d: %w", offset, err)
+		}
+		if int64(count) != length {
+			return "", io.ErrUnexpectedEOF
+		}
+		_, _ = hash.Write(buffer[:length])
+		if bytes.Equal(buffer[:length], zeroes[:length]) {
+			continue
+		}
+		if err := writeAllAt(basefd, buffer[:length], offset); err != nil {
+			return "", err
+		}
+	}
+	if err := unix.Fsync(basefd); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(hash.Sum(nil)), nil
+}
