--- a/packages/orchestrator/pkg/sandbox/rootfs/reflink_test.go
+++ b/packages/orchestrator/pkg/sandbox/rootfs/reflink_test.go
@@ -194,3 +194,84 @@ func TestRememberedReflinkDigestSkipsSecondImageRead(t *testing.T) {
 	resetReflinkDigestCache()
 	require.Error(t, validateReflinkDigest(pathFD, stat, digest, "identity"))
 }
+
+func materializeSparseTestFile(t *testing.T, contents []byte) (*os.File, string) {
+	t.Helper()
+	source := newTestLocalRootfs(t, contents)
+	path := filepath.Join(t.TempDir(), "rootfs.raw")
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, file.Close()) })
+	digest, err := materializeSparseReflinkContents(
+		context.Background(),
+		int(file.Fd()),
+		source,
+		reflinkManifest{DiskSize: int64(len(contents)), BlockSize: 4096},
+	)
+	require.NoError(t, err)
+	return file, digest
+}
+
+func TestSparseReflinkMaterializationPreservesLogicalBytesAndDigest(t *testing.T) {
+	contents := make([]byte, directMaterializeChunkBytes*3+4096)
+	copy(contents, []byte("first allocated range"))
+	copy(contents[directMaterializeChunkBytes*2+123:], []byte("second allocated range"))
+	file, digest := materializeSparseTestFile(t, contents)
+
+	actual := make([]byte, len(contents))
+	count, err := file.ReadAt(actual, 0)
+	require.NoError(t, err)
+	require.Equal(t, len(contents), count)
+	require.Equal(t, contents, actual)
+	require.Equal(t, digestBytes(contents), digest)
+
+	var stat unix.Stat_t
+	require.NoError(t, unix.Fstat(int(file.Fd()), &stat))
+	require.Equal(t, int64(len(contents)), stat.Size)
+	allocated := stat.Blocks * 512
+	if allocated >= stat.Size {
+		t.Skipf("filesystem does not preserve observable holes: allocated=%d logical=%d", allocated, stat.Size)
+	}
+	require.Less(t, allocated, stat.Size)
+}
+
+func TestSparseReflinkMaterializationRejectsNonemptyDestination(t *testing.T) {
+	source := newTestLocalRootfs(t, make([]byte, 4096))
+	path := filepath.Join(t.TempDir(), "rootfs.raw")
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+	require.NoError(t, err)
+	defer file.Close()
+	_, err = file.Write([]byte("existing"))
+	require.NoError(t, err)
+
+	_, err = materializeSparseReflinkContents(
+		context.Background(),
+		int(file.Fd()),
+		source,
+		reflinkManifest{DiskSize: 4096, BlockSize: 4096},
+	)
+	require.ErrorContains(t, err, "must be an empty regular file")
+}
+
+func TestSparseReflinkMaterializationColdVerificationRejectsTamper(t *testing.T) {
+	resetReflinkDigestCache()
+	t.Cleanup(resetReflinkDigestCache)
+
+	contents := make([]byte, directMaterializeChunkBytes*2)
+	copy(contents[directMaterializeChunkBytes:], []byte("allocated tail"))
+	file, digest := materializeSparseTestFile(t, contents)
+	var stat unix.Stat_t
+	require.NoError(t, unix.Fstat(int(file.Fd()), &stat))
+	require.NoError(t, validateReflinkDigest(int(file.Fd()), stat, digest, "sparse-identity"))
+
+	resetReflinkDigestCache() // force the complete cold verification fallback
+	_, err := file.WriteAt([]byte("tampered"), 0)
+	require.NoError(t, err)
+	require.NoError(t, file.Sync())
+	require.NoError(t, unix.Fstat(int(file.Fd()), &stat))
+	require.ErrorContains(
+		t,
+		validateReflinkDigest(int(file.Fd()), stat, digest, "sparse-identity"),
+		"digest does not match",
+	)
+}
