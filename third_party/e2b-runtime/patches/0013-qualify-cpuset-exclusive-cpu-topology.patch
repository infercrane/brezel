+func validateIsolationRoot(root string, config IsolationConfig) error {
+	if !config.Enabled {
+		return nil
+	}
+	info, err := os.Lstat(root)
+	if err != nil {
+		return fmt.Errorf("inspect %s: %w", root, err)
+	}
+	if info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {
+		return fmt.Errorf("%s must be a non-symlink directory", root)
+	}
+	checks := []struct {
+		name     string
+		expected string
+		set      bool
+	}{
+		{name: "cpuset.cpus.partition", expected: "isolated"},
+		{name: "cpuset.cpus.effective", expected: config.CPUs, set: true},
+		{name: "cpuset.cpus.exclusive.effective", expected: config.CPUs, set: true},
+		{name: "cpuset.mems.effective", expected: config.Mems, set: true},
+	}
+	for _, check := range checks {
+		value, readErr := os.ReadFile(filepath.Join(root, check.name))
+		if readErr != nil {
+			return fmt.Errorf("read %s: %w", check.name, readErr)
+		}
+		actual := strings.TrimSpace(string(value))
+		if check.set {
+			equal, compareErr := indexSetsEqual(actual, check.expected)
+			if compareErr != nil {
+				return fmt.Errorf("validate %s: %w", check.name, compareErr)
+			}
+			if !equal {
+				return fmt.Errorf("%s is %q; expected %q", check.name, actual, check.expected)
+			}
+		} else if actual != check.expected {
+			return fmt.Errorf("%s is %q; expected %q", check.name, actual, check.expected)
+		}
+	}
+	procs, err := os.ReadFile(filepath.Join(root, "cgroup.procs"))
+	if err != nil {
+		return fmt.Errorf("read cgroup.procs: %w", err)
+	}
+	if strings.TrimSpace(string(procs)) != "" {
+		return fmt.Errorf("exclusive CPU cgroup contains direct processes before orchestrator start")
+	}
+
+	return nil
+}
+
+func indexSetsEqual(left, right string) (bool, error) {
+	a, err := parseIndexSet(left)
+	if err != nil {
+		return false, fmt.Errorf("parse %q: %w", left, err)
+	}
+	b, err := parseIndexSet(right)
+	if err != nil {
+		return false, fmt.Errorf("parse %q: %w", right, err)
+	}
+	return slices.Equal(a, b), nil
+}
+
+func parseIndexSet(value string) ([]int, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil, errors.New("empty index set")
+	}
+	seen := make(map[int]struct{})
+	for _, part := range strings.Split(value, ",") {
+		part = strings.TrimSpace(part)
+		bounds := strings.Split(part, "-")
+		if len(bounds) > 2 || bounds[0] == "" {
+			return nil, fmt.Errorf("invalid component %q", part)
+		}
+		first, err := strconv.Atoi(bounds[0])
+		if err != nil || first < 0 {
+			return nil, fmt.Errorf("invalid component %q", part)
+		}
+		last := first
+		if len(bounds) == 2 {
+			last, err = strconv.Atoi(bounds[1])
+			if err != nil || last < first {
+				return nil, fmt.Errorf("invalid component %q", part)
+			}
+		}
+		if last > 1<<20 || last-first > 1<<20 {
+			return nil, fmt.Errorf("component %q exceeds the supported range", part)
+		}
+		for index := first; index <= last; index++ {
+			seen[index] = struct{}{}
+		}
+	}
+	result := make([]int, 0, len(seen))
+	for index := range seen {
+		result = append(result, index)
+	}
+	slices.Sort(result)
+
+	return result, nil
 }
 
