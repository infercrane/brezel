+		key := coreKey{node: cpu.node, packageID: cpu.packageID, coreID: cpu.coreID}
+		if _, exists := selectedCores[key]; exists {
+			return exclusiveCPUPlacement{}, fmt.Errorf("multiple vCPUs share physical core %d/%d", cpu.packageID, cpu.coreID)
+		}
+		selectedCores[key] = struct{}{}
+		if selectedNode == -1 {
+			selectedNode = cpu.node
+		} else if cpu.node != selectedNode {
+			return exclusiveCPUPlacement{}, fmt.Errorf("vCPU CPUs cross NUMA nodes")
+		}
+	}
+	var vmmCore coreKey
+	for index, id := range vmmCPUs {
+		cpu, ok := byID[id]
+		if !ok {
+			return exclusiveCPUPlacement{}, fmt.Errorf("VMM CPU %d is not online", id)
+		}
+		if _, ok := reservedSet[id]; !ok {
+			return exclusiveCPUPlacement{}, fmt.Errorf("VMM CPU %d is outside the isolated cpuset", id)
+		}
+		key := coreKey{node: cpu.node, packageID: cpu.packageID, coreID: cpu.coreID}
+		if index == 0 {
+			vmmCore = key
+		} else if key != vmmCore {
+			return exclusiveCPUPlacement{}, fmt.Errorf("VMM CPUs span more than one physical core")
+		}
+	}
+	if vmmCore.node != selectedNode {
+		return exclusiveCPUPlacement{}, fmt.Errorf("VMM and vCPU CPUs cross NUMA nodes")
+	}
+	if _, exists := selectedCores[vmmCore]; exists {
+		return exclusiveCPUPlacement{}, fmt.Errorf("VMM shares a physical core with a vCPU")
+	}
+	expectedReserved := make(map[int]struct{})
+	for core := range selectedCores {
+		for _, id := range byCore[core] {
+			expectedReserved[id] = struct{}{}
+		}
+	}
+	for _, id := range byCore[vmmCore] {
+		expectedReserved[id] = struct{}{}
+		if _, ok := vmmSet[id]; !ok {
+			return exclusiveCPUPlacement{}, fmt.Errorf("VMM cpuset omits sibling CPU %d", id)
+		}
+	}
+	if !sameIntSet(reservedSet, expectedReserved) {
+		return exclusiveCPUPlacement{}, fmt.Errorf("isolated cpuset must contain exactly every sibling of the vCPU and VMM physical cores")
+	}
+	placement := exclusiveCPUPlacement{
+		vcpuCPUs:     append([]int(nil), vcpuCPUs...),
+		helperCPUs:   append([]int(nil), vmmCPUs...),
+		reservedCPUs: append([]int(nil), reserved...),
+	}
+	sort.Ints(placement.vcpuCPUs)
+	sort.Ints(placement.helperCPUs)
+	sort.Ints(placement.reservedCPUs)
+
+	return placement, nil
+}
+
+func intSet(values []int) map[int]struct{} {
+	result := make(map[int]struct{}, len(values))
+	for _, value := range values {
+		result[value] = struct{}{}
+	}
+	return result
+}
+
+func sameIntSet(left, right map[int]struct{}) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for value := range left {
+		if _, ok := right[value]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+func parseCPUList(value string) ([]int, error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil, fmt.Errorf("empty CPU list")
+	}
+	seen := make(map[int]struct{})
+	for _, component := range strings.Split(value, ",") {
+		bounds := strings.Split(strings.TrimSpace(component), "-")
+		if len(bounds) > 2 || len(bounds) == 0 || bounds[0] == "" {
+			return nil, fmt.Errorf("invalid component %q", component)
+		}
+		first, err := strconv.Atoi(bounds[0])
+		if err != nil || first < 0 {
+			return nil, fmt.Errorf("invalid component %q", component)
+		}
+		last := first
+		if len(bounds) == 2 {
+			last, err = strconv.Atoi(bounds[1])
+			if err != nil || last < first {
+				return nil, fmt.Errorf("invalid component %q", component)
+			}
+		}
+		if last > 1<<20 || last-first > 1<<20 {
+			return nil, fmt.Errorf("component %q exceeds supported range", component)
+		}
+		for cpu := first; cpu <= last; cpu++ {
+			seen[cpu] = struct{}{}
+		}
+	}
+	result := make([]int, 0, len(seen))
+	for cpu := range seen {
+		result = append(result, cpu)
+	}
+	sort.Ints(result)
+
+	return result, nil
+}
+
+func validateExclusiveCPUIsolation(pid int, placement *exclusiveCPUPlacement) error {
+	if placement == nil || placement.cgroupRoot == "" {
+		return fmt.Errorf("exclusive CPU isolation contract is missing")
+	}
+	checks := []struct {
+		name     string
+		expected string
+		set      []int
+	}{
+		{name: "cpuset.cpus.partition", expected: "isolated"},
+		{name: "cpuset.cpus.effective", set: placement.reservedCPUs},
+		{name: "cpuset.cpus.exclusive.effective", set: placement.reservedCPUs},
+	}
+	for _, check := range checks {
+		value, err := os.ReadFile(filepath.Join(placement.cgroupRoot, check.name))
+		if err != nil {
+			return fmt.Errorf("read exclusive CPU %s: %w", check.name, err)
+		}
+		actual := strings.TrimSpace(string(value))
+		if check.set != nil {
+			parsed, err := parseCPUList(actual)
+			if err != nil || !equalInts(parsed, check.set) {
+				return fmt.Errorf("exclusive CPU %s drifted to %q", check.name, actual)
+			}
+		} else if actual != check.expected {
+			return fmt.Errorf("exclusive CPU %s drifted to %q", check.name, actual)
+		}
+	}
+	mems, err := os.ReadFile(filepath.Join(placement.cgroupRoot, "cpuset.mems.effective"))
+	if err != nil {
+		return fmt.Errorf("read exclusive CPU cpuset.mems.effective: %w", err)
+	}
+	actualMems, err := parseCPUList(strings.TrimSpace(string(mems)))
+	if err != nil {
+		return fmt.Errorf("parse exclusive CPU cpuset.mems.effective: %w", err)
+	}
+	expectedMems, err := parseCPUList(placement.expectedMems)
+	if err != nil || !equalInts(actualMems, expectedMems) {
+		return fmt.Errorf("exclusive CPU cpuset.mems.effective drifted")
+	}
+	cgroupData, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", pid))
+	if err != nil {
+		return fmt.Errorf("read Firecracker cgroup membership: %w", err)
+	}
+	wantPrefix := strings.TrimPrefix(placement.cgroupRoot, "/sys/fs/cgroup") + "/"
+	cgroupPath := ""
+	for _, line := range strings.Split(string(cgroupData), "\n") {
+		if strings.HasPrefix(line, "0::"+wantPrefix) {
+			cgroupPath = filepath.Join("/sys/fs/cgroup", strings.TrimPrefix(strings.TrimPrefix(line, "0::"), "/"))
+			break
+		}
+	}
+	if cgroupPath == "" {
+		return fmt.Errorf("Firecracker is outside the qualified exclusive CPU cgroup")
+	}
+	return validateEffectiveSandboxCPUSet(cgroupPath, placement.reservedCPUs, expectedMems)
+}
+
+func validateEffectiveSandboxCPUSet(cgroupPath string, expectedCPUs, expectedMems []int) error {
+	if info, err := os.Lstat(cgroupPath); err != nil || info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {
+		return fmt.Errorf("Firecracker sandbox cgroup is not a real directory")
+	}
+	for _, check := range []struct {
+		name     string
+		expected []int
+	}{
+		{name: "cpuset.cpus.effective", expected: expectedCPUs},
+		{name: "cpuset.mems.effective", expected: expectedMems},
+	} {
+		value, err := os.ReadFile(filepath.Join(cgroupPath, check.name))
+		if err != nil {
+			return fmt.Errorf("read Firecracker sandbox %s: %w", check.name, err)
+		}
+		actual, err := parseCPUList(strings.TrimSpace(string(value)))
+		if err != nil || !equalInts(actual, check.expected) {
+			return fmt.Errorf("Firecracker sandbox %s drifted", check.name)
+		}
+	}
+
+	return nil
+}
+
+func equalInts(left, right []int) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if left[index] != right[index] {
+			return false
+		}
+	}
+	return true
+}
