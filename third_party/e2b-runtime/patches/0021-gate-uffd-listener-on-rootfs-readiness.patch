@@ -0,0 +1,102 @@
+//go:build linux
+
+package sandbox
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/utils"
+)
+
+func TestServeMemoryAfterOverlayReadyDoesNotArmListenerDuringSlowOverlay(t *testing.T) {
+	t.Parallel()
+
+	overlayStarted := make(chan struct{})
+	releaseOverlay := make(chan struct{})
+	overlay := utils.NewPromise(func() (rootfs.Provider, error) {
+		close(overlayStarted)
+		<-releaseOverlay
+
+		return nil, nil
+	})
+
+	serveStarted := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		done <- serveMemoryAfterOverlayReady(t.Context(), overlay, func() error {
+			close(serveStarted)
+
+			return nil
+		})
+	}()
+
+	<-overlayStarted
+	// Model an overlay materialization that lasts longer than the listener's
+	// accept window. The important contract is that serving has not started,
+	// so no absolute UFFD deadline is armed during this wait.
+	select {
+	case <-serveStarted:
+		t.Fatal("memory serving started before the rootfs overlay was ready")
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	close(releaseOverlay)
+	require.Eventually(t, func() bool {
+		select {
+		case <-serveStarted:
+			return true
+		default:
+			return false
+		}
+	}, time.Second, time.Millisecond)
+	require.NoError(t, <-done)
+}
+
+func TestServeMemoryAfterOverlayReadyPreservesCancellation(t *testing.T) {
+	t.Parallel()
+
+	releaseOverlay := make(chan struct{})
+	overlay := utils.NewPromise(func() (rootfs.Provider, error) {
+		<-releaseOverlay
+
+		return nil, nil
+	})
+	t.Cleanup(func() { close(releaseOverlay) })
+
+	serveCalled := false
+	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+	defer cancel()
+
+	err := serveMemoryAfterOverlayReady(ctx, overlay, func() error {
+		serveCalled = true
+
+		return nil
+	})
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.ErrorContains(t, err, "failed waiting for rootfs overlay before serving memory")
+	require.False(t, serveCalled)
+}
+
+func TestServeMemoryAfterOverlayReadyPropagatesOverlayFailure(t *testing.T) {
+	t.Parallel()
+
+	want := errors.New("materialization failed")
+	overlay := utils.NewPromise(func() (rootfs.Provider, error) {
+		return nil, want
+	})
+
+	serveCalled := false
+	err := serveMemoryAfterOverlayReady(t.Context(), overlay, func() error {
+		serveCalled = true
+
+		return nil
+	})
+	require.ErrorIs(t, err, want)
+	require.False(t, serveCalled)
+}
