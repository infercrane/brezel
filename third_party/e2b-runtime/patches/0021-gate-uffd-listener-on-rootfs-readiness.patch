+
+// serveMemoryAfterOverlayReady keeps the UFFD listener's absolute accept
+// deadline from covering rootfs preparation. A first-use direct/reflink
+// overlay may spend much longer than that materializing its immutable base.
+// Starting UFFD before the overlay is ready makes the listener expire while
+// no Firecracker process can connect to it yet.
+func serveMemoryAfterOverlayReady(
+	ctx context.Context,
+	overlay *utils.Promise[rootfs.Provider],
+	serve func() error,
+) error {
+	if _, err := overlay.Wait(ctx); err != nil {
+		return fmt.Errorf("failed waiting for rootfs overlay before serving memory: %w", err)
+	}
+
+	return serve()
 }
 
