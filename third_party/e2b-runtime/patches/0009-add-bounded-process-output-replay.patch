+++ b/packages/envd/internal/services/process/handler/journal_test.go
@@ -0,0 +1,177 @@
+package handler
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	rpc "github.com/e2b-dev/infra/packages/envd/internal/services/spec/process"
+)
+
+func stdoutEvent(value string) *rpc.ProcessEvent {
+	return &rpc.ProcessEvent{Event: &rpc.ProcessEvent_Data{Data: &rpc.ProcessEvent_DataEvent{
+		Output: &rpc.ProcessEvent_DataEvent_Stdout{Stdout: []byte(value)},
+	}}}
+}
+
+func stderrEvent(value string) *rpc.ProcessEvent {
+	return &rpc.ProcessEvent{Event: &rpc.ProcessEvent_Data{Data: &rpc.ProcessEvent_DataEvent{
+		Output: &rpc.ProcessEvent_DataEvent_Stderr{Stderr: []byte(value)},
+	}}}
+}
+
+func endEvent(code int32) *rpc.ProcessEvent {
+	return &rpc.ProcessEvent{Event: &rpc.ProcessEvent_End{End: &rpc.ProcessEvent_EndEvent{
+		Exited: true, ExitCode: code, Status: "exited",
+	}}}
+}
+
+func TestEventJournalPreservesMixedOrderingAndClones(t *testing.T) {
+	t.Parallel()
+
+	j := NewJournalStore().NewJournal()
+	first := stdoutEvent("one")
+	require.NoError(t, j.Append(first))
+	first.GetData().GetStdout()[0] = 'X'
+	require.NoError(t, j.Append(stderrEvent("two")))
+	require.NoError(t, j.Append(endEvent(7)))
+
+	seq, event, wait, err := j.Next(0)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(1), seq)
+	assert.Equal(t, "one", string(event.GetData().GetStdout()))
+	assert.Nil(t, wait)
+
+	seq, event, _, err = j.Next(seq)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(2), seq)
+	assert.Equal(t, "two", string(event.GetData().GetStderr()))
+
+	seq, event, _, err = j.Next(seq)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(3), seq)
+	assert.Equal(t, int32(7), event.GetEnd().GetExitCode())
+
+	_, event, wait, err = j.Next(seq)
+	require.NoError(t, err)
+	assert.Nil(t, event)
+	assert.Nil(t, wait, "caught-up terminal journals return EOF without waiting")
+}
+
+func TestEventJournalAtomicReplayToWaitHandoff(t *testing.T) {
+	t.Parallel()
+
+	j := NewJournalStore().NewJournal()
+	_, event, wait, err := j.Next(0)
+	require.NoError(t, err)
+	require.Nil(t, event)
+	require.NotNil(t, wait)
+
+	require.NoError(t, j.Append(stdoutEvent("arrived")))
+	select {
+	case <-wait:
+	case <-time.After(time.Second):
+		t.Fatal("append did not wake a cursor that atomically entered wait")
+	}
+
+	seq, event, _, err := j.Next(0)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(1), seq)
+	assert.Equal(t, "arrived", string(event.GetData().GetStdout()))
+}
+
+func TestEventJournalPerProcessEvictionIsExplicit(t *testing.T) {
+	t.Parallel()
+
+	store := NewJournalStoreWithLimits(JournalLimits{ProcessEvents: 2, StoreEvents: 10})
+	j := store.NewJournal()
+	require.NoError(t, j.Append(stdoutEvent("one")))
+	evictedRecord := j.records[0]
+	require.NoError(t, j.Append(stdoutEvent("two")))
+	require.NoError(t, j.Append(stdoutEvent("three")))
+
+	_, _, _, err := j.Next(0)
+	assert.ErrorIs(t, err, ErrJournalCursorEvicted)
+	assert.Nil(t, evictedRecord.event, "eviction must release the retained protobuf payload")
+
+	seq, event, _, err := j.Next(1)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(2), seq)
+	assert.Equal(t, "two", string(event.GetData().GetStdout()))
+}
+
+func TestJournalStoreGlobalEvictionIsExplicitPerAffectedProcess(t *testing.T) {
+	t.Parallel()
+
+	store := NewJournalStoreWithLimits(JournalLimits{ProcessEvents: 10, StoreEvents: 2})
+	a := store.NewJournal()
+	b := store.NewJournal()
+	require.NoError(t, a.Append(stdoutEvent("a1")))
+	require.NoError(t, b.Append(stdoutEvent("b1")))
+	require.NoError(t, a.Append(stdoutEvent("a2")))
+
+	_, _, _, err := a.Next(0)
+	assert.ErrorIs(t, err, ErrJournalCursorEvicted)
+	seq, event, _, err := b.Next(0)
+	require.NoError(t, err)
+	assert.Equal(t, uint64(1), seq)
+	assert.Equal(t, "b1", string(event.GetData().GetStdout()))
+	assert.Equal(t, 2, store.events)
+}
+
+func TestEventJournalRejectsInvalidCursorsAndRelease(t *testing.T) {
+	t.Parallel()
+
+	j := NewJournalStore().NewJournal()
+	require.NoError(t, j.Append(stdoutEvent("one")))
+	_, _, _, err := j.Next(2)
+	assert.ErrorIs(t, err, ErrJournalCursorAhead)
+
+	j.Release()
+	_, _, _, err = j.Next(0)
+	assert.ErrorIs(t, err, ErrJournalReleased)
+	assert.ErrorIs(t, j.Append(stdoutEvent("late")), ErrJournalReleased)
+}
+
+func TestEventJournalConcurrentAppendHasContiguousUniqueSequence(t *testing.T) {
+	t.Parallel()
+
+	const count = 512
+	store := NewJournalStoreWithLimits(JournalLimits{ProcessEvents: count, StoreEvents: count})
+	j := store.NewJournal()
+
+	var wg sync.WaitGroup
+	errs := make(chan error, count)
+	for i := range count {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			errs <- j.Append(stdoutEvent(fmt.Sprintf("%d", i)))
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+
+	seen := make(map[string]bool, count)
+	var cursor uint64
+	for range count {
+		sequence, event, _, err := j.Next(cursor)
+		require.NoError(t, err)
+		require.Equal(t, cursor+1, sequence)
+		value := string(event.GetData().GetStdout())
+		require.False(t, seen[value], "duplicate output record %q", value)
+		seen[value] = true
+		cursor = sequence
+	}
+	assert.Len(t, seen, count)
+	assert.Equal(t, uint64(count), j.LastSequence())
+	assert.False(t, errors.Is(j.ValidateCursor(cursor), ErrJournalCursorAhead))
+}
