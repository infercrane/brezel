diff --git a/packages/envd/internal/services/process/handler/journal.go b/packages/envd/internal/services/process/handler/journal.go
new file mode 100644
index 0000000..6659180
--- /dev/null
+++ b/packages/envd/internal/services/process/handler/journal.go
@@ -0,0 +1,274 @@
+package handler
+
+import (
+	"container/list"
+	"errors"
+	"fmt"
+	"sync"
+
+	"github.com/google/uuid"
+	"google.golang.org/protobuf/proto"
+
+	rpc "github.com/e2b-dev/infra/packages/envd/internal/services/spec/process"
+)
+
+const (
+	defaultJournalBytes       = 8 << 20
+	defaultJournalEvents      = 8192
+	defaultJournalStoreBytes  = 32 << 20
+	defaultJournalStoreEvents = 32768
+	journalRecordOverhead     = 256
+)
+
+var (
+	ErrJournalClosed        = errors.New("process output journal is closed")
+	ErrJournalReleased      = errors.New("process output journal was released")
+	ErrJournalCursorEvicted = errors.New("process output cursor was evicted")
+	ErrJournalCursorAhead   = errors.New("process output cursor is ahead of the journal")
+)
+
+type JournalLimits struct {
+	ProcessBytes  int
+	ProcessEvents int
+	StoreBytes    int
+	StoreEvents   int
+}
+
+func DefaultJournalLimits() JournalLimits {
+	return JournalLimits{
+		ProcessBytes:  defaultJournalBytes,
+		ProcessEvents: defaultJournalEvents,
+		StoreBytes:    defaultJournalStoreBytes,
+		StoreEvents:   defaultJournalStoreEvents,
+	}
+}
+
+type journalRecord struct {
+	journal  *EventJournal
+	sequence uint64
+	event    *rpc.ProcessEvent
+	cost     int
+	evicted  bool
+	global   *list.Element
+}
+
+// JournalStore applies both per-process and envd-wide memory bounds. All
+// record insertion, eviction and cursor inspection uses one mutex; this is the
+// serialization point that makes the replay-to-live handoff gap-free.
+type JournalStore struct {
+	mu sync.Mutex
+
+	limits JournalLimits
+	global list.List
+	bytes  int
+	events int
+}
+
+func NewJournalStore() *JournalStore {
+	return NewJournalStoreWithLimits(DefaultJournalLimits())
+}
+
+func NewJournalStoreWithLimits(limits JournalLimits) *JournalStore {
+	return &JournalStore{limits: limits}
+}
+
+func (s *JournalStore) NewJournal() *EventJournal {
+	return &EventJournal{
+		store:  s,
+		id:     uuid.NewString(),
+		notify: make(chan struct{}),
+	}
+}
+
+// EventJournal stores Data and End events only. Start is synthetic and
+// KeepAlive is transport-level, so neither advances the durable cursor.
+type EventJournal struct {
+	store *JournalStore
+	id    string
+
+	records        []*journalRecord
+	head           int
+	bytes          int
+	lastSequence   uint64
+	evictedThrough uint64
+	terminal       bool
+	released       bool
+	notify         chan struct{}
+}
+
+func (j *EventJournal) ID() string { return j.id }
+
+func (j *EventJournal) LastSequence() uint64 {
+	j.store.mu.Lock()
+	defer j.store.mu.Unlock()
+
+	return j.lastSequence
+}
+
+func (j *EventJournal) ValidateCursor(after uint64) error {
+	j.store.mu.Lock()
+	defer j.store.mu.Unlock()
+
+	return j.validateCursorLocked(after)
+}
+
+func (j *EventJournal) Append(event *rpc.ProcessEvent) error {
+	if event == nil || (event.GetData() == nil && event.GetEnd() == nil) {
+		return errors.New("process output journal only accepts data or end events")
+	}
+
+	cloned := proto.Clone(event).(*rpc.ProcessEvent)
+	record := &journalRecord{
+		journal: j,
+		event:   cloned,
+		cost:    proto.Size(cloned) + journalRecordOverhead,
+	}
+
+	s := j.store
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if j.released {
+		return ErrJournalReleased
+	}
+	if j.terminal {
+		return ErrJournalClosed
+	}
+
+	j.lastSequence++
+	record.sequence = j.lastSequence
+	j.records = append(j.records, record)
+	j.bytes += record.cost
+	record.global = s.global.PushBack(record)
+	s.bytes += record.cost
+	s.events++
+	if cloned.GetEnd() != nil {
+		j.terminal = true
+	}
+
+	s.wakeLocked(j)
+	for s.overProcessLimitLocked(j) {
+		s.evictOldestFromJournalLocked(j)
+	}
+	for s.overStoreLimitLocked() {
+		s.evictOldestGlobalLocked()
+	}
+	s.compactLocked(j)
+
+	return nil
+}
+
+// Next returns the first retained record after the acknowledged sequence. If
+// no record exists yet, wait is closed by the next append, eviction or release.
+// The caller must advance its cursor only after successfully delivering event.
+func (j *EventJournal) Next(after uint64) (sequence uint64, event *rpc.ProcessEvent, wait <-chan struct{}, err error) {
+	s := j.store
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if err := j.validateCursorLocked(after); err != nil {
+		return 0, nil, nil, err
+	}
+
+	offset := after - j.evictedThrough
+	idx := j.head + int(offset)
+	if idx < len(j.records) {
+		r := j.records[idx]
+		return r.sequence, proto.Clone(r.event).(*rpc.ProcessEvent), nil, nil
+	}
+	if j.terminal {
+		return 0, nil, nil, nil
+	}
+
+	return 0, nil, j.notify, nil
+}
+
+func (j *EventJournal) validateCursorLocked(after uint64) error {
+	if j.released {
+		return ErrJournalReleased
+	}
+	if after > j.lastSequence {
+		return fmt.Errorf("%w: requested %d, latest %d", ErrJournalCursorAhead, after, j.lastSequence)
+	}
+	if after < j.evictedThrough {
+		return fmt.Errorf("%w: requested %d, oldest available %d", ErrJournalCursorEvicted, after, j.evictedThrough)
+	}
+
+	return nil
+}
+
+// Release removes all retained data immediately and wakes every waiter. A
+// released generation can never be mistaken for an empty journal.
+func (j *EventJournal) Release() {
+	s := j.store
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if j.released {
+		return
+	}
+	j.released = true
+	for j.head < len(j.records) {
+		s.evictRecordLocked(j.records[j.head])
+	}
+	s.wakeLocked(j)
+	j.records = nil
+	j.head = 0
+}
+
+func (s *JournalStore) overProcessLimitLocked(j *EventJournal) bool {
+	return (s.limits.ProcessBytes > 0 && j.bytes > s.limits.ProcessBytes) ||
+		(s.limits.ProcessEvents > 0 && len(j.records)-j.head > s.limits.ProcessEvents)
+}
+
+func (s *JournalStore) overStoreLimitLocked() bool {
+	return (s.limits.StoreBytes > 0 && s.bytes > s.limits.StoreBytes) ||
+		(s.limits.StoreEvents > 0 && s.events > s.limits.StoreEvents)
+}
+
+func (s *JournalStore) evictOldestFromJournalLocked(j *EventJournal) {
+	for j.head < len(j.records) && j.records[j.head].evicted {
+		j.head++
+	}
+	if j.head < len(j.records) {
+		s.evictRecordLocked(j.records[j.head])
+	}
+}
+
+func (s *JournalStore) evictOldestGlobalLocked() {
+	if oldest := s.global.Front(); oldest != nil {
+		s.evictRecordLocked(oldest.Value.(*journalRecord))
+	}
+}
+
+func (s *JournalStore) evictRecordLocked(r *journalRecord) {
+	if r.evicted {
+		return
+	}
+	r.evicted = true
+	if r.global != nil {
+		s.global.Remove(r.global)
+		r.global = nil
+	}
+	r.journal.bytes -= r.cost
+	r.journal.evictedThrough = r.sequence
+	s.bytes -= r.cost
+	s.events--
+	r.event = nil
+	for r.journal.head < len(r.journal.records) && r.journal.records[r.journal.head].evicted {
+		r.journal.head++
+	}
+	s.wakeLocked(r.journal)
+}
+
+func (s *JournalStore) wakeLocked(j *EventJournal) {
+	close(j.notify)
+	j.notify = make(chan struct{})
+}
+
+func (s *JournalStore) compactLocked(j *EventJournal) {
+	if j.head > 1024 && j.head*2 >= len(j.records) {
+		j.records = append([]*journalRecord(nil), j.records[j.head:]...)
+		j.head = 0
+	}
+}
