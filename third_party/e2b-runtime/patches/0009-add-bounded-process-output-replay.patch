+func TestConnect_ReplaysExactSuffixInJournalOrder(t *testing.T) {
+	t.Parallel()
+
+	client, svc, cleanup := newRetentionTestService(t)
+	defer cleanup()
+
+	const pid = uint32(8101)
+	logger := zerolog.Nop()
+	journal := svc.journals.NewJournal()
+	h := handler.Readopt(handler.ReadoptArgs{Pid: pid, Journal: journal}, &logger)
+	svc.processes.Store(pid, h)
+	require.NoError(t, journal.Append(&rpc.ProcessEvent{Event: &rpc.ProcessEvent_Data{Data: &rpc.ProcessEvent_DataEvent{
+		Output: &rpc.ProcessEvent_DataEvent_Stdout{Stdout: []byte("already-seen")},
+	}}}))
+	require.NoError(t, journal.Append(&rpc.ProcessEvent{Event: &rpc.ProcessEvent_Data{Data: &rpc.ProcessEvent_DataEvent{
+		Output: &rpc.ProcessEvent_DataEvent_Stderr{Stderr: []byte("replay-me")},
+	}}}))
+	require.NoError(t, journal.Append(&rpc.ProcessEvent{Event: &rpc.ProcessEvent_End{End: &rpc.ProcessEvent_EndEvent{
+		Exited: true, ExitCode: 3, Status: "exited",
+	}}}))
+
+	request := connect.NewRequest(&rpc.ConnectRequest{
+		Process: &rpc.ProcessSelector{Selector: &rpc.ProcessSelector_Pid{Pid: pid}},
+	})
+	request.Header().Set(afterSequenceHeader, "1")
+	request.Header().Set(journalIDHeader, journal.ID())
+	stream, err := client.Connect(t.Context(), request)
+	require.NoError(t, err)
+	events := drainConnect(t, stream)
+
+	require.Len(t, events, 3, "synthetic Start plus the two records after cursor 1")
+	assert.Equal(t, pid, events[0].GetStart().GetPid())
+	assert.Equal(t, "replay-me", string(events[1].GetData().GetStderr()))
+	assert.Equal(t, int32(3), events[2].GetEnd().GetExitCode())
+	assert.Equal(t, replayVersion, stream.ResponseHeader().Get(replayVersionHeader))
+	assert.Equal(t, journal.ID(), stream.ResponseHeader().Get(journalIDHeader))
+}
