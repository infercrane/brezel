new file mode 100644
index 0000000..dce84d8
--- /dev/null
+++ b/packages/envd/internal/services/process/replay.go
@@ -0,0 +1,116 @@
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	"connectrpc.com/connect"
+
+	"github.com/e2b-dev/infra/packages/envd/internal/services/process/handler"
+	rpc "github.com/e2b-dev/infra/packages/envd/internal/services/spec/process"
+)
+
+const (
+	replayVersionHeader = "E2b-Process-Replay-Version"
+	journalIDHeader     = "E2b-Process-Journal-Id"
+	afterSequenceHeader = "E2b-Process-After-Sequence"
+	replayVersion       = "1"
+)
+
+type replayRequest struct {
+	enabled   bool
+	journalID string
+	after     uint64
+}
+
+func parseReplayRequest(header http.Header) (replayRequest, error) {
+	raw := header.Get(afterSequenceHeader)
+	if raw == "" {
+		return replayRequest{}, nil
+	}
+
+	after, err := strconv.ParseUint(raw, 10, 64)
+	if err != nil {
+		return replayRequest{}, fmt.Errorf("invalid %s: %w", afterSequenceHeader, err)
+	}
+	id := header.Get(journalIDHeader)
+	if id == "" {
+		return replayRequest{}, fmt.Errorf("%s is required with %s", journalIDHeader, afterSequenceHeader)
+	}
+
+	return replayRequest{enabled: true, journalID: id, after: after}, nil
+}
+
+func journalConnectError(err error) error {
+	switch {
+	case errors.Is(err, handler.ErrJournalCursorEvicted), errors.Is(err, handler.ErrJournalCursorAhead):
+		return connect.NewError(connect.CodeOutOfRange, err)
+	case errors.Is(err, handler.ErrJournalReleased):
+		return connect.NewError(connect.CodeFailedPrecondition, err)
+	default:
+		return connect.NewError(connect.CodeInternal, err)
+	}
+}
+
+func validateReplayRequest(request replayRequest, journal *handler.EventJournal) error {
+	if !request.enabled {
+		return nil
+	}
+	if request.journalID != "" && request.journalID != journal.ID() {
+		return connect.NewError(connect.CodeFailedPrecondition, fmt.Errorf("process output generation changed: requested %q, current %q", request.journalID, journal.ID()))
+	}
+
+	return nil
+}
+
+func advertiseReplay(header http.Header, journal *handler.EventJournal) {
+	header.Set(replayVersionHeader, replayVersion)
+	header.Set(journalIDHeader, journal.ID())
+}
+
+// streamJournal serializes all Data and End delivery through the journal's
+// sequence order. The cursor advances only after Send succeeds. Poll and
+// append share the JournalStore mutex, so transitioning from retained records
+// to the wait channel cannot miss an append.
+func streamJournal(
+	ctx context.Context,
+	journal *handler.EventJournal,
+	after uint64,
+	keepalive <-chan time.Time,
+	resetKeepalive func(),
+	send func(*rpc.ProcessEvent) error,
+) error {
+	cursor := after
+	for {
+		sequence, event, wait, err := journal.Next(cursor)
+		if err != nil {
+			return journalConnectError(err)
+		}
+		if event != nil {
+			if err := send(event); err != nil {
+				return connect.NewError(connect.CodeUnknown, fmt.Errorf("error sending process event: %w", err))
+			}
+			cursor = sequence
+			resetKeepalive()
+
+			continue
+		}
+		if wait == nil {
+			return nil
+		}
+
+		select {
+		case <-ctx.Done():
+			return context.Cause(ctx)
+		case <-wait:
+		case <-keepalive:
+			if err := send(&rpc.ProcessEvent{Event: &rpc.ProcessEvent_Keepalive{Keepalive: &rpc.ProcessEvent_KeepAlive{}}}); err != nil {
+				return connect.NewError(connect.CodeUnknown, fmt.Errorf("error sending keepalive: %w", err))
+			}
+		}
+	}
+}
