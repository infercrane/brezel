diff --git a/packages/orchestrator/pkg/sandbox/rootfs/direct_lifecycle_test.go b/packages/orchestrator/pkg/sandbox/rootfs/direct_lifecycle_test.go
new file mode 100644
index 0000000..84650c9
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/rootfs/direct_lifecycle_test.go
@@ -0,0 +1,155 @@
+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func newDirectTarget(t *testing.T, contents []byte) string {
+	t.Helper()
+
+	path := filepath.Join(t.TempDir(), "rootfs.cow")
+	require.NoError(t, os.WriteFile(path, contents, 0o600))
+
+	return path
+}
+
+func newDiffOutput(t *testing.T) *os.File {
+	t.Helper()
+
+	out, err := os.Create(filepath.Join(t.TempDir(), "rootfs.diff"))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, out.Close()) })
+
+	return out
+}
+
+func TestBorrowedDirectProviderClosePreservesTemplateRootfs(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	copy(contents, []byte("template-rootfs"))
+	rootfs := newTestLocalRootfs(t, contents)
+	target := newDirectTarget(t, contents)
+
+	provider, err := NewDirectProvider(t.Context(), rootfs, target)
+	require.NoError(t, err)
+	require.NoError(t, provider.Close(t.Context()))
+	require.NoError(t, provider.Close(t.Context()), "Close must remain idempotent")
+
+	got, err := os.ReadFile(target)
+	require.NoError(t, err)
+	assert.Equal(t, contents, got)
+}
+
+func TestBorrowedDirectProviderExportPreservesTemplateRootfs(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	copy(contents, []byte("template-export"))
+	rootfs := newTestLocalRootfs(t, contents)
+	target := newDirectTarget(t, contents)
+	provider, err := NewDirectProvider(t.Context(), rootfs, target)
+	require.NoError(t, err)
+
+	_, err = provider.ExportDiff(t.Context(), newDiffOutput(t), provider.Close)
+	require.NoError(t, err)
+
+	got, err := os.ReadFile(target)
+	require.NoError(t, err)
+	assert.Equal(t, contents, got)
+}
+
+func TestOwnedDirectRuntimeCloseRemovesOnlyPrivateClone(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	copy(contents, []byte("runtime-rootfs"))
+	rootfs := newTestLocalRootfs(t, contents)
+	target := filepath.Join(t.TempDir(), "rootfs.cow")
+
+	provider, err := NewRuntimeProvider(
+		t.Context(),
+		"direct",
+		rootfs,
+		target,
+		"",
+		nil,
+		nil,
+		1,
+	)
+	require.NoError(t, err)
+	require.NoError(t, provider.Close(t.Context()))
+	require.NoError(t, provider.Close(t.Context()), "Close must remain idempotent")
+
+	_, err = os.Stat(target)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	sourceBytes := make([]byte, len(contents))
+	_, err = rootfs.ReadAt(t.Context(), sourceBytes, 0)
+	require.NoError(t, err)
+	assert.Equal(t, contents, sourceBytes)
+}
+
+func TestOwnedDirectProviderCloseDuringExportDoesNotRemoveClone(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	rootfs := newTestLocalRootfs(t, contents)
+	target := newDirectTarget(t, contents)
+	provider, err := newOwnedDirectProvider(t.Context(), rootfs, target)
+	require.NoError(t, err)
+	direct := provider.(*DirectProvider)
+
+	// ExportDiff wins this same compare-and-swap before invoking its stop hook.
+	// Close must only signal release in that state; deleting here would race the
+	// exporter's subsequent open of the path.
+	direct.closed.Store(true)
+	require.NoError(t, direct.Close(t.Context()))
+	_, err = os.Stat(target)
+	require.NoError(t, err)
+
+	// Finish the synthetic lifecycle so the test does not retain the mapping.
+	direct.closed.Store(false)
+	require.NoError(t, direct.Close(t.Context()))
+}
+
+func TestOwnedDirectProviderExportRemovesCloneAfterExport(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	copy(contents, []byte("owned-export"))
+	rootfs := newTestLocalRootfs(t, contents)
+	target := newDirectTarget(t, contents)
+	provider, err := newOwnedDirectProvider(t.Context(), rootfs, target)
+	require.NoError(t, err)
+
+	_, err = provider.ExportDiff(t.Context(), newDiffOutput(t), provider.Close)
+	require.NoError(t, err)
+	_, err = os.Stat(target)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+}
+
+func TestOwnedDirectProviderExportTimeoutPreservesClone(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	rootfs := newTestLocalRootfs(t, contents)
+	target := newDirectTarget(t, contents)
+	provider, err := newOwnedDirectProvider(t.Context(), rootfs, target)
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+	defer cancel()
+	_, err = provider.ExportDiff(ctx, newDiffOutput(t), func(context.Context) error { return nil })
+	require.ErrorContains(t, err, "timeout waiting for overlay device to be released")
+	_, err = os.Stat(target)
+	require.NoError(t, err, "an unconfirmed release must fail safe by retaining the clone")
+}
