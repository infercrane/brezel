@@ -0,0 +1,174 @@
+//go:build linux
+
+package fc
+
+import (
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func TestChooseExclusiveCPUPlacementUsesDistinctCoresOnOneNode(t *testing.T) {
+	t.Parallel()
+
+	topology := []hostCPU{
+		{id: 0, node: 0, packageID: 0, coreID: 0},
+		{id: 8, node: 0, packageID: 0, coreID: 0},
+		{id: 1, node: 0, packageID: 0, coreID: 1},
+		{id: 9, node: 0, packageID: 0, coreID: 1},
+		{id: 2, node: 1, packageID: 0, coreID: 2},
+		{id: 10, node: 1, packageID: 0, coreID: 2},
+	}
+
+	placement, err := chooseExclusiveCPUPlacement(topology, 2)
+	require.NoError(t, err)
+	require.Equal(t, []int{0, 1}, placement.vcpuCPUs)
+	require.Equal(t, []int{2, 10}, placement.helperCPUs)
+}
+
+func TestChooseExclusiveCPUPlacementRequiresSeparateHelperCore(t *testing.T) {
+	t.Parallel()
+
+	topology := []hostCPU{
+		{id: 0, node: 0, packageID: 0, coreID: 0},
+		{id: 8, node: 0, packageID: 0, coreID: 0},
+		{id: 1, node: 0, packageID: 0, coreID: 1},
+		{id: 9, node: 0, packageID: 0, coreID: 1},
+	}
+
+	_, err := chooseExclusiveCPUPlacement(topology, 2)
+	require.ErrorContains(t, err, "no host CPU remains for Firecracker helper threads")
+}
+
+func TestExclusiveCPULeaseRejectsConcurrentHolder(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "cpu.lock")
+	first, err := acquireExclusiveCPULease(path)
+	require.NoError(t, err)
+	defer first.Close()
+
+	_, err = acquireExclusiveCPULease(path)
+	require.ErrorContains(t, err, "another Firecracker process holds")
+
+	require.NoError(t, unix.Flock(int(first.Fd()), unix.LOCK_UN))
+	require.NoError(t, first.Close())
+	second, err := acquireExclusiveCPULease(path)
+	require.NoError(t, err)
+	require.NoError(t, second.Close())
+}
+
+func TestChooseExclusiveCPUPlacementRejectsCrossNUMAVCPUs(t *testing.T) {
+	t.Parallel()
+
+	topology := []hostCPU{
+		{id: 0, node: 0, packageID: 0, coreID: 0},
+		{id: 1, node: 1, packageID: 0, coreID: 1},
+	}
+
+	_, err := chooseExclusiveCPUPlacement(topology, 2)
+	require.ErrorContains(t, err, "no NUMA node has 2 distinct physical cores")
+}
+
+func TestFirecrackerVCPUIndex(t *testing.T) {
+	t.Parallel()
+
+	index, ok := firecrackerVCPUIndex("fc_vcpu 7")
+	require.True(t, ok)
+	require.Equal(t, 7, index)
+
+	_, ok = firecrackerVCPUIndex("fc_api")
+	require.False(t, ok)
+}
+
+func TestExclusiveCPUAssignmentsMoveLateHelpersOffVCPUCores(t *testing.T) {
+	t.Parallel()
+
+	placement := &exclusiveCPUPlacement{vcpuCPUs: []int{2, 3}, helperCPUs: []int{0, 1, 4, 5}}
+	initial, err := exclusiveCPUAssignments([]firecrackerTask{
+		{tid: 100, name: "firecracker"},
+		{tid: 101, name: "fc_vcpu 0"},
+		{tid: 102, name: "fc_vcpu 1"},
+	}, placement)
+	require.NoError(t, err)
+	require.Equal(t, []taskCPUAssignment{
+		{tid: 100, name: "firecracker", cpus: []int{0, 1, 4, 5}},
+		{tid: 101, name: "fc_vcpu 0", cpus: []int{2}},
+		{tid: 102, name: "fc_vcpu 1", cpus: []int{3}},
+	}, initial)
+
+	reconciled, err := exclusiveCPUAssignments([]firecrackerTask{
+		{tid: 100, name: "firecracker"},
+		{tid: 101, name: "fc_vcpu 0"},
+		{tid: 102, name: "fc_vcpu 1"},
+		{tid: 103, name: "kvm-nx-lpage-re"},
+	}, placement)
+	require.NoError(t, err)
+	require.Equal(t, taskCPUAssignment{tid: 103, name: "kvm-nx-lpage-re", cpus: []int{0, 1, 4, 5}}, reconciled[3])
+}
+
+func TestExclusiveCPUAssignmentsFailClosedWhenVCPUDisappears(t *testing.T) {
+	t.Parallel()
+
+	placement := &exclusiveCPUPlacement{vcpuCPUs: []int{2, 3}, helperCPUs: []int{0, 1}}
+	_, err := exclusiveCPUAssignments([]firecrackerTask{
+		{tid: 100, name: "firecracker"},
+		{tid: 101, name: "fc_vcpu 0"},
+	}, placement)
+	require.ErrorContains(t, err, "vCPU thread 1 was not present")
+}
+
+func TestMonitorExclusiveCPUPlacementFailsClosed(t *testing.T) {
+	t.Parallel()
+
+	exited := make(chan struct{})
+	stopped := make(chan struct{})
+	ticks := make(chan time.Time, 2)
+	want := errors.New("affinity drift")
+	failed := make(chan error, 1)
+	done := make(chan struct{})
+	applications := 0
+	go func() {
+		monitorExclusiveCPUPlacement(exited, stopped, ticks, func() error {
+			applications++
+			if applications == 1 {
+				return nil
+			}
+			return want
+		}, func(err error) {
+			failed <- err
+		})
+		close(done)
+	}()
+
+	ticks <- time.Now()
+	ticks <- time.Now()
+	require.ErrorIs(t, <-failed, want)
+	<-done
+	require.Equal(t, 2, applications)
+}
+
+func TestMonitorExclusiveCPUPlacementStopsBeforeApplying(t *testing.T) {
+	t.Parallel()
+
+	exited := make(chan struct{})
+	stopped := make(chan struct{})
+	ticks := make(chan time.Time, 1)
+	done := make(chan struct{})
+	go func() {
+		monitorExclusiveCPUPlacement(exited, stopped, ticks, func() error {
+			t.Fatal("placement was applied after the monitor stopped")
+			return nil
+		}, func(error) {
+			t.Fatal("monitor reported a failure after it stopped")
+		})
+		close(done)
+	}()
+
+	close(stopped)
+	<-done
+}
