+func (p *Process) startExclusiveCPUPlacementMonitor(ctx context.Context) {
+	if p.cpuPlacement == nil || p.cmd.Process == nil {
+		return
+	}
+	pid := p.cmd.Process.Pid
+	go func() {
+		ticker := time.NewTicker(time.Second)
+		defer ticker.Stop()
+		monitorExclusiveCPUPlacement(
+			p.Exit.Done(),
+			p.cpuPlacementMonitorStop,
+			ticker.C,
+			func() error { return applyExclusiveCPUPlacement(pid, p.cpuPlacement) },
+			func(err error) {
+				failure := &exclusiveCPUPlacementFailure{err: fmt.Errorf("reconcile exclusive Firecracker CPU topology: %w", err)}
+				if p.cpuPlacementFailure.CompareAndSwap(nil, failure) {
+					logger.L().Error(ctx, "terminating Firecracker after CPU placement failure", zap.Error(failure.err), logger.WithSandboxID(p.files.SandboxID))
+					if killErr := p.cmd.Process.Kill(); killErr != nil && !errors.Is(killErr, os.ErrProcessDone) {
+						logger.L().Error(ctx, "failed to terminate Firecracker after CPU placement failure", zap.Error(killErr), logger.WithSandboxID(p.files.SandboxID))
+					}
+				}
+			},
+		)
+	}()
+}
+
+func monitorExclusiveCPUPlacement(
+	exited <-chan struct{},
+	stopped <-chan struct{},
+	ticks <-chan time.Time,
+	apply func() error,
+	fail func(error),
+) {
+	for {
+		select {
+		case <-exited:
+			return
+		case <-stopped:
+			return
+		case <-ticks:
+			if err := apply(); err != nil {
+				select {
+				case <-exited:
+					return
+				case <-stopped:
+					return
+				default:
+				}
+				fail(err)
+
+				return
+			}
+		}
+	}
+}
+
+func (p *Process) stopExclusiveCPUPlacementMonitor() {
+	if p.cpuPlacementMonitorStop == nil {
+		return
+	}
+	p.cpuPlacementMonitorStopOnce.Do(func() {
+		close(p.cpuPlacementMonitorStop)
+	})
+}
