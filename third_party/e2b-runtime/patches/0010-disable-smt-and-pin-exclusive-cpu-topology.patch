+++ b/packages/orchestrator/pkg/sandbox/fc/cpu_affinity_test.go
@@ -0,0 +1,84 @@
+//go:build linux
+
+package fc
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func TestChooseExclusiveCPUPlacementUsesDistinctCoresOnOneNode(t *testing.T) {
+	t.Parallel()
+
+	topology := []hostCPU{
+		{id: 0, node: 0, packageID: 0, coreID: 0},
+		{id: 8, node: 0, packageID: 0, coreID: 0},
+		{id: 1, node: 0, packageID: 0, coreID: 1},
+		{id: 9, node: 0, packageID: 0, coreID: 1},
+		{id: 2, node: 1, packageID: 0, coreID: 2},
+		{id: 10, node: 1, packageID: 0, coreID: 2},
+	}
+
+	placement, err := chooseExclusiveCPUPlacement(topology, 2)
+	require.NoError(t, err)
+	require.Equal(t, []int{0, 1}, placement.vcpuCPUs)
+	require.Equal(t, []int{2, 10}, placement.helperCPUs)
+}
+
+func TestChooseExclusiveCPUPlacementRequiresSeparateHelperCore(t *testing.T) {
+	t.Parallel()
+
+	topology := []hostCPU{
+		{id: 0, node: 0, packageID: 0, coreID: 0},
+		{id: 8, node: 0, packageID: 0, coreID: 0},
+		{id: 1, node: 0, packageID: 0, coreID: 1},
+		{id: 9, node: 0, packageID: 0, coreID: 1},
+	}
+
+	_, err := chooseExclusiveCPUPlacement(topology, 2)
+	require.ErrorContains(t, err, "no host CPU remains for Firecracker helper threads")
+}
+
+func TestExclusiveCPULeaseRejectsConcurrentHolder(t *testing.T) {
+	t.Parallel()
+
+	path := filepath.Join(t.TempDir(), "cpu.lock")
+	first, err := acquireExclusiveCPULease(path)
+	require.NoError(t, err)
+	defer first.Close()
+
+	_, err = acquireExclusiveCPULease(path)
+	require.ErrorContains(t, err, "another Firecracker process holds")
+
+	require.NoError(t, unix.Flock(int(first.Fd()), unix.LOCK_UN))
+	require.NoError(t, first.Close())
+	second, err := acquireExclusiveCPULease(path)
+	require.NoError(t, err)
+	require.NoError(t, second.Close())
+}
+
+func TestChooseExclusiveCPUPlacementRejectsCrossNUMAVCPUs(t *testing.T) {
+	t.Parallel()
+
+	topology := []hostCPU{
+		{id: 0, node: 0, packageID: 0, coreID: 0},
+		{id: 1, node: 1, packageID: 0, coreID: 1},
+	}
+
+	_, err := chooseExclusiveCPUPlacement(topology, 2)
+	require.ErrorContains(t, err, "no NUMA node has 2 distinct physical cores")
+}
+
+func TestFirecrackerVCPUIndex(t *testing.T) {
+	t.Parallel()
+
+	index, ok := firecrackerVCPUIndex("fc_vcpu 7")
+	require.True(t, ok)
+	require.Equal(t, 7, index)
+
+	_, ok = firecrackerVCPUIndex("fc_api")
+	require.False(t, ok)
+}
