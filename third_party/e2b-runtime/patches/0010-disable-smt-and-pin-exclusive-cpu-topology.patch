diff --git a/packages/orchestrator/pkg/sandbox/fc/cpu_affinity.go b/packages/orchestrator/pkg/sandbox/fc/cpu_affinity.go
new file mode 100644
index 0000000..c90700e
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/fc/cpu_affinity.go
@@ -0,0 +1,356 @@
+//go:build linux
+
+package fc
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+type hostCPU struct {
+	id        int
+	node      int
+	packageID int
+	coreID    int
+}
+
+type exclusiveCPUPlacement struct {
+	vcpuCPUs   []int
+	helperCPUs []int
+	lease      *os.File
+}
+
+type firecrackerTask struct {
+	tid  int
+	name string
+}
+
+type taskCPUAssignment struct {
+	tid  int
+	name string
+	cpus []int
+}
+
+const exclusiveCPULockPath = "/run/lock/brezel-firecracker-exclusive-cpu.lock"
+
+const (
+	exclusiveCPUPlacementStabilization = 250 * time.Millisecond
+	exclusiveCPUPlacementPollInterval  = 10 * time.Millisecond
+)
+
+func acquireExclusiveCPUPlacement(vcpuCount int) (*exclusiveCPUPlacement, error) {
+	lease, err := acquireExclusiveCPULease(exclusiveCPULockPath)
+	if err != nil {
+		return nil, err
+	}
+	releaseOnError := true
+	defer func() {
+		if releaseOnError {
+			_ = lease.Close()
+		}
+	}()
+
+	topology, err := readHostCPUTopology(os.Getpid())
+	if err != nil {
+		return nil, err
+	}
+	placement, err := chooseExclusiveCPUPlacement(topology, vcpuCount)
+	if err != nil {
+		return nil, err
+	}
+	placement.lease = lease
+	releaseOnError = false
+	return &placement, nil
+}
+
+func acquireExclusiveCPULease(path string) (*os.File, error) {
+	fd, err := unix.Open(path, unix.O_RDWR|unix.O_CREAT|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("open exclusive Firecracker CPU lease: %w", err)
+	}
+	lease := os.NewFile(uintptr(fd), path)
+	if lease == nil {
+		_ = unix.Close(fd)
+		return nil, fmt.Errorf("create exclusive Firecracker CPU lease handle")
+	}
+	releaseOnError := true
+	defer func() {
+		if releaseOnError {
+			_ = lease.Close()
+		}
+	}()
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil {
+		return nil, fmt.Errorf("inspect exclusive Firecracker CPU lease: %w", err)
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFREG {
+		return nil, fmt.Errorf("exclusive Firecracker CPU lease is not a regular file")
+	}
+	if err := unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		if err == unix.EWOULDBLOCK {
+			return nil, fmt.Errorf("another Firecracker process holds the exclusive CPU lease")
+		}
+		return nil, fmt.Errorf("acquire exclusive Firecracker CPU lease: %w", err)
+	}
+
+	releaseOnError = false
+	return lease, nil
+}
+
+func constrainFirecrackerCPUPlacement(pid int, placement *exclusiveCPUPlacement) error {
+	all := append(append([]int(nil), placement.vcpuCPUs...), placement.helperCPUs...)
+	if err := setProcessTaskAffinity(pid, all); err != nil {
+		return fmt.Errorf("constrain Firecracker before VM start: %w", err)
+	}
+	return nil
+}
+
+func (p *exclusiveCPUPlacement) release() error {
+	if p == nil || p.lease == nil {
+		return nil
+	}
+	lease := p.lease
+	p.lease = nil
+	if err := unix.Flock(int(lease.Fd()), unix.LOCK_UN); err != nil {
+		_ = lease.Close()
+		return err
+	}
+	return lease.Close()
+}
+
+func applyExclusiveCPUPlacement(pid int, placement *exclusiveCPUPlacement) error {
+	tasks, err := readFirecrackerTasks(pid)
+	if err != nil {
+		return err
+	}
+	assignments, err := exclusiveCPUAssignments(tasks, placement)
+	if err != nil {
+		return err
+	}
+	for _, assignment := range assignments {
+		if err := setTaskAffinity(assignment.tid, assignment.cpus); err != nil {
+			return fmt.Errorf("pin Firecracker task %q: %w", assignment.name, err)
+		}
+	}
+	return nil
+}
+
+func readFirecrackerTasks(pid int) ([]firecrackerTask, error) {
+	entries, err := os.ReadDir(fmt.Sprintf("/proc/%d/task", pid))
+	if err != nil {
+		return nil, fmt.Errorf("list Firecracker tasks: %w", err)
+	}
+	tasks := make([]firecrackerTask, 0, len(entries))
+	for _, entry := range entries {
+		tid, err := strconv.Atoi(entry.Name())
+		if err != nil {
+			continue
+		}
+		nameBytes, err := os.ReadFile(fmt.Sprintf("/proc/%d/task/%d/comm", pid, tid))
+		if err != nil {
+			return nil, fmt.Errorf("read Firecracker task %d name: %w", tid, err)
+		}
+		tasks = append(tasks, firecrackerTask{tid: tid, name: strings.TrimSpace(string(nameBytes))})
+	}
+	return tasks, nil
+}
+
+func exclusiveCPUAssignments(tasks []firecrackerTask, placement *exclusiveCPUPlacement) ([]taskCPUAssignment, error) {
+	if placement == nil {
+		return nil, fmt.Errorf("exclusive CPU placement is nil")
+	}
+	found := make([]bool, len(placement.vcpuCPUs))
+	assignments := make([]taskCPUAssignment, 0, len(tasks))
+	for _, task := range tasks {
+		if index, ok := firecrackerVCPUIndex(task.name); ok {
+			if index >= len(placement.vcpuCPUs) {
+				return nil, fmt.Errorf("Firecracker exposed unexpected vCPU thread %q", task.name)
+			}
+			assignments = append(assignments, taskCPUAssignment{tid: task.tid, name: task.name, cpus: []int{placement.vcpuCPUs[index]}})
+			found[index] = true
+			continue
+		}
+		assignments = append(assignments, taskCPUAssignment{tid: task.tid, name: task.name, cpus: append([]int(nil), placement.helperCPUs...)})
+	}
+	for index, present := range found {
+		if !present {
+			return nil, fmt.Errorf("Firecracker vCPU thread %d was not present after VM start", index)
+		}
+	}
+	return assignments, nil
+}
+
+// Firecracker and KVM create a small number of helper threads after the vCPU
+// threads become visible. Reconcile for a bounded startup window before the VM
+// is exposed as ready; the process monitor handles any still-later threads.
+func stabilizeExclusiveCPUPlacement(pid int, placement *exclusiveCPUPlacement) error {
+	deadline := time.Now().Add(exclusiveCPUPlacementStabilization)
+	for {
+		if err := applyExclusiveCPUPlacement(pid, placement); err != nil {
+			return err
+		}
+		if !time.Now().Before(deadline) {
+			return nil
+		}
+		time.Sleep(exclusiveCPUPlacementPollInterval)
+	}
+}
+
+func firecrackerVCPUIndex(name string) (int, bool) {
+	const prefix = "fc_vcpu "
+	if !strings.HasPrefix(name, prefix) {
+		return 0, false
+	}
+	index, err := strconv.Atoi(strings.TrimPrefix(name, prefix))
+	return index, err == nil && index >= 0
+}
+
+func chooseExclusiveCPUPlacement(topology []hostCPU, vcpuCount int) (exclusiveCPUPlacement, error) {
+	if vcpuCount < 1 {
+		return exclusiveCPUPlacement{}, fmt.Errorf("vCPU count must be positive")
+	}
+	type coreKey struct{ packageID, coreID int }
+	byNode := make(map[int]map[coreKey][]int)
+	for _, cpu := range topology {
+		if byNode[cpu.node] == nil {
+			byNode[cpu.node] = make(map[coreKey][]int)
+		}
+		key := coreKey{packageID: cpu.packageID, coreID: cpu.coreID}
+		byNode[cpu.node][key] = append(byNode[cpu.node][key], cpu.id)
+	}
+	nodes := make([]int, 0, len(byNode))
+	for node := range byNode {
+		nodes = append(nodes, node)
+	}
+	sort.Ints(nodes)
+	for _, node := range nodes {
+		cores := byNode[node]
+		if len(cores) < vcpuCount {
+			continue
+		}
+		keys := make([]coreKey, 0, len(cores))
+		for key := range cores {
+			keys = append(keys, key)
+		}
+		sort.Slice(keys, func(i, j int) bool {
+			if keys[i].packageID != keys[j].packageID {
+				return keys[i].packageID < keys[j].packageID
+			}
+			return keys[i].coreID < keys[j].coreID
+		})
+		placement := exclusiveCPUPlacement{}
+		for _, key := range keys[:vcpuCount] {
+			cpus := cores[key]
+			sort.Ints(cpus)
+			placement.vcpuCPUs = append(placement.vcpuCPUs, cpus[0])
+		}
+		for _, key := range keys[vcpuCount:] {
+			placement.helperCPUs = append(placement.helperCPUs, cores[key]...)
+		}
+		if len(placement.helperCPUs) == 0 {
+			for _, otherNode := range nodes {
+				if otherNode == node {
+					continue
+				}
+				for _, cpus := range byNode[otherNode] {
+					placement.helperCPUs = append(placement.helperCPUs, cpus...)
+				}
+			}
+		}
+		sort.Ints(placement.helperCPUs)
+		if len(placement.helperCPUs) == 0 {
+			return exclusiveCPUPlacement{}, fmt.Errorf("no host CPU remains for Firecracker helper threads")
+		}
+		return placement, nil
+	}
+	return exclusiveCPUPlacement{}, fmt.Errorf("no NUMA node has %d distinct physical cores", vcpuCount)
+}
+
+func readHostCPUTopology(pid int) ([]hostCPU, error) {
+	var allowed unix.CPUSet
+	if err := unix.SchedGetaffinity(pid, &allowed); err != nil {
+		return nil, fmt.Errorf("read Firecracker allowed CPUs: %w", err)
+	}
+	var topology []hostCPU
+	for cpu := 0; cpu < len(allowed)*64; cpu++ {
+		if !allowed.IsSet(cpu) {
+			continue
+		}
+		base := fmt.Sprintf("/sys/devices/system/cpu/cpu%d", cpu)
+		coreID, err := readTopologyInteger(filepath.Join(base, "topology/core_id"))
+		if err != nil {
+			return nil, err
+		}
+		packageID, err := readTopologyInteger(filepath.Join(base, "topology/physical_package_id"))
+		if err != nil {
+			return nil, err
+		}
+		node := 0
+		matches, err := filepath.Glob(filepath.Join(base, "node[0-9]*"))
+		if err != nil {
+			return nil, fmt.Errorf("read CPU %d NUMA node: %w", cpu, err)
+		}
+		if len(matches) > 0 {
+			node, err = strconv.Atoi(strings.TrimPrefix(filepath.Base(matches[0]), "node"))
+			if err != nil {
+				return nil, fmt.Errorf("parse CPU %d NUMA node: %w", cpu, err)
+			}
+		}
+		topology = append(topology, hostCPU{id: cpu, node: node, packageID: packageID, coreID: coreID})
+	}
+	if len(topology) == 0 {
+		return nil, fmt.Errorf("Firecracker has no allowed host CPUs")
+	}
+	return topology, nil
+}
+
+func readTopologyInteger(path string) (int, error) {
+	value, err := os.ReadFile(path)
+	if err != nil {
+		return 0, fmt.Errorf("read %s: %w", path, err)
+	}
+	parsed, err := strconv.Atoi(strings.TrimSpace(string(value)))
+	if err != nil {
+		return 0, fmt.Errorf("parse %s: %w", path, err)
+	}
+	return parsed, nil
+}
+
+func setProcessTaskAffinity(pid int, cpus []int) error {
+	tasks, err := os.ReadDir(fmt.Sprintf("/proc/%d/task", pid))
+	if err != nil {
+		return err
+	}
+	for _, task := range tasks {
+		tid, err := strconv.Atoi(task.Name())
+		if err != nil {
+			continue
+		}
+		if err := setTaskAffinity(tid, cpus); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func setTaskAffinity(tid int, cpus []int) error {
+	if len(cpus) == 0 {
+		return fmt.Errorf("empty CPU set")
+	}
+	var set unix.CPUSet
+	set.Zero()
+	for _, cpu := range cpus {
+		if cpu < 0 || cpu >= len(set)*64 {
+			return fmt.Errorf("CPU %d exceeds supported affinity range", cpu)
+		}
+		set.Set(cpu)
+	}
+	return unix.SchedSetaffinity(tid, &set)
+}
