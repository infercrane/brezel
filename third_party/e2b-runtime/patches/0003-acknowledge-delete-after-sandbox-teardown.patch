 }
 
+// WaitLifecycle blocks until one exact sandbox lifecycle has completed its
+// resource cleanup. A sandbox can already be absent from live while its
+// Firecracker, NBD, network, and memory resources are still being reclaimed.
+func (m *Map) WaitLifecycle(ctx context.Context, sandboxID, lifecycleID string) error {
+	key := sandboxLifecycleKey(sandboxID, lifecycleID)
+	for {
+		m.lifecycleMu.Lock()
+		_, exists := m.lifecycles.Get(key)
+		if !exists {
+			m.lifecycleMu.Unlock()
+
+			return nil
+		}
+
+		changed := m.lifecycleChanged
+		m.lifecycleMu.Unlock()
+
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("waiting for sandbox lifecycle cleanup: %w", ctx.Err())
+		case <-changed:
+		}
+	}
+}
