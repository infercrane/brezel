diff --git a/packages/orchestrator/pkg/factories/run_rootfs_test.go b/packages/orchestrator/pkg/factories/run_rootfs_test.go
new file mode 100644
index 000000000..9196f4d52
--- /dev/null
+++ b/packages/orchestrator/pkg/factories/run_rootfs_test.go
@@ -0,0 +1,57 @@
+//go:build linux
+
+package factories
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/nbd"
+)
+
+func TestNewRuntimeDevicePoolOnlySuppressesReflinkWithoutTemplateManager(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name                string
+		provider            string
+		runsTemplateManager bool
+		wantPool            bool
+	}{
+		{name: "nbd runtime", provider: "nbd", wantPool: true},
+		{name: "direct diagnostics", provider: "direct", wantPool: true},
+		{name: "reflink template manager", provider: "reflink", runsTemplateManager: true, wantPool: true},
+		{name: "reflink-only orchestrator", provider: "reflink", wantPool: false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+
+			want := &nbd.DevicePool{}
+			created := 0
+			got, err := newRuntimeDevicePool(test.provider, test.runsTemplateManager, 64, func(size int) (*nbd.DevicePool, error) {
+				created++
+				assert.Equal(t, 64, size)
+
+				return want, nil
+			})
+			require.NoError(t, err)
+			if test.wantPool {
+				assert.Same(t, want, got)
+				assert.Equal(t, 1, created)
+			} else {
+				assert.Nil(t, got)
+				assert.Zero(t, created)
+			}
+		})
+	}
+
+	got, err := newRuntimeDevicePool("future-provider", false, 64, func(int) (*nbd.DevicePool, error) {
+		return &nbd.DevicePool{}, nil
+	})
+	require.ErrorContains(t, err, "unsupported sandbox rootfs provider")
+	assert.Nil(t, got)
+}
