+type devicePoolFactory func(int) (*nbd.DevicePool, error)
+
+// newRuntimeDevicePool keeps the kernel NBD pool coupled to a real consumer.
+// Reflink-only orchestrators pass ordinary file paths to Firecracker and do
+// not need a background NBD scanner. Template-manager still requires NBD for
+// offline ensurefreedisk work, even when sandbox execution uses reflink.
+func newRuntimeDevicePool(provider string, runsTemplateManager bool, size int, create devicePoolFactory) (*nbd.DevicePool, error) {
+	switch provider {
+	case "nbd", "direct":
+		return create(size)
+	case "reflink":
+		if runsTemplateManager {
+			return create(size)
+		}
+
+		return nil, nil
+	default:
+		return nil, fmt.Errorf("unsupported sandbox rootfs provider %q", provider)
+	}
+}
