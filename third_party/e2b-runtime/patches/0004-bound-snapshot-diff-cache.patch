+// allocatedBytes returns physical filesystem blocks attributed to regular files
+// below path. It deliberately does not follow symlinks and uses st_blocks rather
+// than apparent length so sparse snapshot diffs are not charged as fully
+// allocated. Reflinked extents may be counted more than once; that conservative
+// accounting causes earlier eviction without permitting the cache to exceed its
+// configured high water silently.
+func allocatedBytes(path string) (uint64, error) {
+	var total uint64
+	err := filepath.WalkDir(path, func(entryPath string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			if os.IsNotExist(walkErr) {
+				return nil
+			}
+
+			return walkErr
+		}
+		if entry.Type()&os.ModeSymlink != 0 || entry.IsDir() {
+			return nil
+		}
+
+		var stat unix.Stat_t
+		if err := unix.Lstat(entryPath, &stat); err != nil {
+			if os.IsNotExist(err) {
+				return nil
+			}
+
+			return err
+		}
+		if stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Blocks <= 0 {
+			return nil
+		}
+
+		blocks := uint64(stat.Blocks)
+		if blocks > (^uint64(0)-total)/512 {
+			return fmt.Errorf("allocated byte count overflow")
+		}
+		total += blocks * 512
+
+		return nil
+	})
+	if err != nil {
+		return 0, fmt.Errorf("failed to walk build cache %s: %w", path, err)
+	}
+
+	return total, nil
+}
