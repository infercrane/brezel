+func pathIsEqualOrBelow(path, root string) (bool, error) {
+	relative, err := filepath.Rel(root, path)
+	if err != nil {
+		return false, err
+	}
+
+	return relative == "." || (relative != ".." && !strings.HasPrefix(relative, ".."+string(os.PathSeparator))), nil
+}
+
+// validateSandboxRootfsMountBoundary prevents the Firecracker mount namespace
+// from hiding a per-sandbox rootfs link or a reflink base. startScriptV2 mounts
+// tmpfs at SANDBOX_DIR before linking the host rootfs into that directory, so a
+// source below the mountpoint becomes unreachable in that namespace.
+func validateSandboxRootfsMountBoundary(config BuilderConfig) error {
+	paths := []struct {
+		name string
+		path string
+	}{
+		{name: "SANDBOX_CACHE_DIR", path: config.StorageConfig.SandboxCacheDir},
+	}
+	if config.SandboxRootfsProvider == "reflink" {
+		paths = append(paths, struct {
+			name string
+			path string
+		}{name: "SANDBOX_ROOTFS_REFLINK_CACHE_DIR", path: config.SandboxRootfsReflinkCacheDir})
+	}
+	for _, candidate := range paths {
+		shadowed, err := pathIsEqualOrBelow(candidate.path, config.SandboxDir)
+		if err != nil {
+			return fmt.Errorf("failed to compare %s with SANDBOX_DIR: %w", candidate.name, err)
+		}
+		if shadowed {
+			return fmt.Errorf("%s must be outside SANDBOX_DIR because Firecracker mounts tmpfs at SANDBOX_DIR", candidate.name)
+		}
+	}
+
+	return nil
+}
