diff --git a/packages/orchestrator/pkg/sandbox/rootfs/provider.go b/packages/orchestrator/pkg/sandbox/rootfs/provider.go
new file mode 100644
index 0000000000000000000000000000000000000000..1424c708fcc2e839c90f78c2259ec1debd2da181
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/rootfs/provider.go
@@ -0,0 +1,164 @@
+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/block"
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/nbd"
+	"github.com/e2b-dev/infra/packages/shared/pkg/featureflags"
+)
+
+const directMaterializeChunkBytes int64 = 4 << 20
+
+// NewRuntimeProvider is the single provider-selection boundary for regular
+// sandbox create and resume. NBD remains the default in configuration; callers
+// must pass the exact value "direct" or "reflink" to materialize a private
+// raw rootfs. Selection and materialization finish before Firecracker is
+// created, so unsupported storage fails closed outside the VM boundary.
+func NewRuntimeProvider(
+	ctx context.Context,
+	provider string,
+	rootfs block.ReadonlyDevice,
+	cachePath string,
+	reflinkCacheDir string,
+	devicePool *nbd.DevicePool,
+	featureFlags *featureflags.Client,
+	nbdConnections int,
+) (Provider, error) {
+	switch provider {
+	case "nbd":
+		return NewNBDProvider(
+			ctx,
+			rootfs,
+			cachePath,
+			devicePool,
+			featureFlags,
+			nbdConnections,
+		)
+	case "direct":
+		return newMaterializedDirectProvider(ctx, rootfs, cachePath)
+	case "reflink":
+		return newMaterializedReflinkProvider(ctx, rootfs, cachePath, reflinkCacheDir)
+	default:
+		return nil, fmt.Errorf("unsupported sandbox rootfs provider %q", provider)
+	}
+}
+
+// newMaterializedDirectProvider makes one private, writable raw image for a
+// sandbox before exposing it to Firecracker. The source can be local or lazy;
+// ReadAt is the only boundary used, so no host path supplied by a template is
+// trusted. O_EXCL prevents replacing or following an existing cache path.
+//
+// This intentionally materializes the complete virtual disk. It is an opt-in
+// runtime A/B mechanism, not a persistence or export guarantee. NBD remains the
+// operational default until direct mode has separate lifecycle qualification.
+func newMaterializedDirectProvider(
+	ctx context.Context,
+	rootfs block.ReadonlyDevice,
+	cachePath string,
+) (_ Provider, resultErr error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("direct rootfs materialization canceled: %w", err)
+	}
+	if rootfs == nil {
+		return nil, errors.New("direct rootfs provider requires a source device")
+	}
+	if cachePath == "" {
+		return nil, errors.New("direct rootfs provider requires a private cache path")
+	}
+
+	size, err := rootfs.Size(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("getting direct rootfs size: %w", err)
+	}
+	blockSize := rootfs.BlockSize()
+	if size <= 0 || blockSize <= 0 || size%blockSize != 0 {
+		return nil, fmt.Errorf(
+			"direct rootfs requires a positive block-aligned image: size=%d block_size=%d",
+			size,
+			blockSize,
+		)
+	}
+
+	file, err := os.OpenFile(cachePath, os.O_RDWR|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("creating private direct rootfs: %w", err)
+	}
+	keep := false
+	closed := false
+	defer func() {
+		var closeErr error
+		if !closed {
+			closeErr = file.Close()
+		}
+		if !keep {
+			removeErr := os.Remove(cachePath)
+			if removeErr != nil && !errors.Is(removeErr, os.ErrNotExist) {
+				resultErr = errors.Join(resultErr, fmt.Errorf("removing incomplete direct rootfs: %w", removeErr))
+			}
+		}
+		if closeErr != nil && resultErr == nil {
+			resultErr = fmt.Errorf("closing direct rootfs: %w", closeErr)
+		}
+	}()
+
+	if err := file.Truncate(size); err != nil {
+		return nil, fmt.Errorf("sizing direct rootfs: %w", err)
+	}
+	// Direct mode consumes a complete private raw image per sandbox. Reserve
+	// every byte now instead of allowing sparse-file overcommit to become an
+	// ENOSPC write fault after the VM starts. Unsupported filesystems fail this
+	// opt-in arm before Firecracker exists; the default NBD path is unaffected.
+	if err := unix.Fallocate(int(file.Fd()), 0, 0, size); err != nil {
+		return nil, fmt.Errorf("reserving direct rootfs storage: %w", err)
+	}
+
+	chunkSize := directMaterializeChunkBytes
+	if blockSize > chunkSize {
+		chunkSize = blockSize
+	} else {
+		chunkSize -= chunkSize % blockSize
+	}
+	buf := make([]byte, chunkSize)
+	for offset := int64(0); offset < size; offset += chunkSize {
+		if err := ctx.Err(); err != nil {
+			return nil, fmt.Errorf("direct rootfs materialization canceled: %w", err)
+		}
+		length := min(chunkSize, size-offset)
+		n, readErr := rootfs.ReadAt(ctx, buf[:length], offset)
+		if readErr != nil {
+			return nil, fmt.Errorf("reading direct rootfs at offset %d: %w", offset, readErr)
+		}
+		if int64(n) != length {
+			return nil, fmt.Errorf("reading direct rootfs at offset %d: %w", offset, io.ErrUnexpectedEOF)
+		}
+		n, writeErr := file.WriteAt(buf[:length], offset)
+		if writeErr != nil {
+			return nil, fmt.Errorf("writing direct rootfs at offset %d: %w", offset, writeErr)
+		}
+		if int64(n) != length {
+			return nil, fmt.Errorf("writing direct rootfs at offset %d: %w", offset, io.ErrShortWrite)
+		}
+	}
+
+	if err := file.Close(); err != nil {
+		return nil, fmt.Errorf("closing materialized direct rootfs: %w", err)
+	}
+	closed = true
+
+	provider, err := NewDirectProvider(ctx, rootfs, cachePath)
+	if err != nil {
+		return nil, fmt.Errorf("opening materialized direct rootfs: %w", err)
+	}
+	keep = true
+
+	return provider, nil
+}
diff --git a/packages/orchestrator/pkg/sandbox/rootfs/provider_test.go b/packages/orchestrator/pkg/sandbox/rootfs/provider_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c010462cffd5f5ddd5cc6d65dc5b884197715b46
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/rootfs/provider_test.go
@@ -0,0 +1,138 @@
+//go:build linux
+
+package rootfs
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/pkg/sandbox/block"
+)
+
+func newTestLocalRootfs(t *testing.T, contents []byte) *block.Local {
+	t.Helper()
+
+	sourcePath := filepath.Join(t.TempDir(), "source.raw")
+	require.NoError(t, os.WriteFile(sourcePath, contents, 0o600))
+	device, err := block.NewLocal(sourcePath, 4096, uuid.New())
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, device.Close()) })
+
+	return device
+}
+
+func TestNewRuntimeProviderRejectsUnknownProviderBeforeCreatingCache(t *testing.T) {
+	t.Parallel()
+
+	target := filepath.Join(t.TempDir(), "rootfs.cow")
+	provider, err := NewRuntimeProvider(
+		context.Background(),
+		"raw",
+		newTestLocalRootfs(t, make([]byte, 4096)),
+		target,
+		"",
+		nil,
+		nil,
+		1,
+	)
+	require.ErrorContains(t, err, `unsupported sandbox rootfs provider "raw"`)
+	assert.Nil(t, provider)
+	_, statErr := os.Stat(target)
+	assert.ErrorIs(t, statErr, os.ErrNotExist)
+}
+
+func TestDirectRuntimeProviderMaterializesPrivateIndependentRawFile(t *testing.T) {
+	t.Parallel()
+
+	contents := make([]byte, 8192)
+	copy(contents, []byte("template-data"))
+	source := newTestLocalRootfs(t, contents)
+	target := filepath.Join(t.TempDir(), "rootfs.cow")
+
+	provider, err := NewRuntimeProvider(
+		context.Background(),
+		"direct",
+		source,
+		target,
+		"",
+		nil,
+		nil,
+		1,
+	)
+	require.NoError(t, err)
+	require.NoError(t, provider.Start(context.Background()))
+	t.Cleanup(func() { require.NoError(t, provider.Close(context.Background())) })
+
+	path, err := provider.Path()
+	require.NoError(t, err)
+	assert.Equal(t, target, path)
+	materialized, err := os.ReadFile(path)
+	require.NoError(t, err)
+	assert.Equal(t, contents, materialized)
+	info, err := os.Stat(path)
+	require.NoError(t, err)
+	assert.Zero(t, info.Mode().Perm()&0o077)
+
+	targetFile, err := os.OpenFile(path, os.O_WRONLY, 0)
+	require.NoError(t, err)
+	_, err = targetFile.WriteAt([]byte("sandbox"), 0)
+	require.NoError(t, err)
+	require.NoError(t, targetFile.Close())
+
+	sourceBytes := make([]byte, len(contents))
+	_, err = source.ReadAt(context.Background(), sourceBytes, 0)
+	require.NoError(t, err)
+	assert.Equal(t, contents, sourceBytes)
+}
+
+func TestDirectRuntimeProviderFailsClosedOnExistingTarget(t *testing.T) {
+	t.Parallel()
+
+	target := filepath.Join(t.TempDir(), "rootfs.cow")
+	require.NoError(t, os.WriteFile(target, []byte("owned"), 0o600))
+	provider, err := NewRuntimeProvider(
+		context.Background(),
+		"direct",
+		newTestLocalRootfs(t, make([]byte, 4096)),
+		target,
+		"",
+		nil,
+		nil,
+		1,
+	)
+	require.Error(t, err)
+	assert.Nil(t, provider)
+	contents, readErr := os.ReadFile(target)
+	require.NoError(t, readErr)
+	assert.Equal(t, []byte("owned"), contents)
+}
+
+func TestDirectRuntimeProviderCancellationLeavesNoPartialImage(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	target := filepath.Join(t.TempDir(), "rootfs.cow")
+	provider, err := NewRuntimeProvider(
+		ctx,
+		"direct",
+		newTestLocalRootfs(t, make([]byte, 4096)),
+		target,
+		"",
+		nil,
+		nil,
+		1,
+	)
+	require.Error(t, err)
+	assert.True(t, errors.Is(err, context.Canceled))
+	assert.Nil(t, provider)
+	_, statErr := os.Stat(target)
+	assert.ErrorIs(t, statErr, os.ErrNotExist)
+}
