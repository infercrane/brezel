+package process
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/envd/internal/services/process/handler"
+	rpc "github.com/e2b-dev/infra/packages/envd/internal/services/spec/process"
+	"github.com/e2b-dev/infra/packages/envd/internal/utils"
+)
+
+// TestGetProcessByTagScansPastNonMatches guards the sync.Map Range callback
+// contract. Returning false stops iteration, so non-matching live processes
+// must return true and only the matching process may stop the scan.
+func TestGetProcessByTagScansPastNonMatches(t *testing.T) {
+	t.Parallel()
+
+	const (
+		attempts       = 64
+		nonMatchCount = 64
+	)
+	for attempt := range attempts {
+		service := &Service{processes: utils.NewMap[uint32, *handler.Handler]()}
+		for index := range nonMatchCount {
+			tag := fmt.Sprintf("other-%d-%d", attempt, index)
+			service.processes.Store(uint32(index+1), &handler.Handler{Tag: &tag})
+		}
+		service.processes.Store(10_000, &handler.Handler{})
+
+		targetTag := fmt.Sprintf("target-%d", attempt)
+		target := &handler.Handler{Tag: &targetTag}
+		service.processes.Store(20_000, target)
+
+		got, err := service.getProcess(&rpc.ProcessSelector{
+			Selector: &rpc.ProcessSelector_Tag{Tag: targetTag},
+		})
+		require.NoError(t, err)
+		require.Same(t, target, got)
+	}
+}
