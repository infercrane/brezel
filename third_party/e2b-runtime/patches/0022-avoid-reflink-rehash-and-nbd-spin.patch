+	resetReflinkDigestCache() // model a fresh orchestrator process
+	require.ErrorContains(
+		t,
+		validateReflinkDigest(int(file.Fd()), stat, digestBytes([]byte("different")), "identity"),
+		"digest does not match",
+	)
+}
