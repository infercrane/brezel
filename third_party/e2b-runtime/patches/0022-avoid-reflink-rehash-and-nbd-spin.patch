+func TestRememberedReflinkDigestSkipsSecondImageRead(t *testing.T) {
+	resetReflinkDigestCache()
+	t.Cleanup(resetReflinkDigestCache)
+
+	contents := []byte("read exactly once during publication")
+	path := filepath.Join(t.TempDir(), "rootfs.raw")
+	require.NoError(t, os.WriteFile(path, contents, 0o600))
+
+	pathFD, err := unix.Open(path, unix.O_PATH|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	require.NoError(t, err)
+	defer unix.Close(pathFD)
+	var stat unix.Stat_t
+	require.NoError(t, unix.Fstat(pathFD, &stat))
+	digest := digestBytes(contents)
+
+	// O_PATH supports inode validation but cannot be read. Success therefore
+	// proves the exact remembered fingerprint avoids a second image scan.
+	rememberVerifiedReflinkDigest(stat, digest, "identity")
+	require.NoError(t, validateReflinkDigest(pathFD, stat, digest, "identity"))
