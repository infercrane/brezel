+func resetReflinkDigestCache() {
+	reflinkDigestCache.Lock()
+	defer reflinkDigestCache.Unlock()
+	reflinkDigestCache.entries = make(map[string]reflinkFingerprint)
+}
+
+func digestBytes(contents []byte) string {
+	digest := sha256.Sum256(contents)
+	return hex.EncodeToString(digest[:])
+}
+
+func TestRememberedReflinkDigestRequiresExactPublishedInodeFingerprint(t *testing.T) {
+	resetReflinkDigestCache()
+	t.Cleanup(resetReflinkDigestCache)
+
+	contents := []byte("verified immutable contents")
+	path := filepath.Join(t.TempDir(), "rootfs.raw")
+	require.NoError(t, os.WriteFile(path, contents, 0o600))
+	file, err := os.OpenFile(path, os.O_RDWR, 0)
+	require.NoError(t, err)
+	defer file.Close()
+
+	var before unix.Stat_t
+	require.NoError(t, unix.Fstat(int(file.Fd()), &before))
+	digest := digestBytes(contents)
+	rememberVerifiedReflinkDigest(before, digest, "identity")
+	require.NoError(t, validateReflinkDigest(int(file.Fd()), before, digest, "identity"))
+
+	_, err = file.WriteAt([]byte("tampered beyond original contents"), int64(len(contents)))
+	require.NoError(t, err)
+	require.NoError(t, file.Sync())
+	var after unix.Stat_t
+	require.NoError(t, unix.Fstat(int(file.Fd()), &after))
+	require.NotEqual(t, before.Size, after.Size, "tamper must invalidate the cached inode fingerprint")
+	require.ErrorContains(t, validateReflinkDigest(int(file.Fd()), after, digest, "identity"), "digest does not match")
+}
+
+func TestRememberedReflinkDigestRejectsSameSizeTamper(t *testing.T) {
+	resetReflinkDigestCache()
+	t.Cleanup(resetReflinkDigestCache)
+
+	contents := []byte("verified-image-a")
+	tampered := []byte("tampered-image-a")
+	require.Len(t, tampered, len(contents))
+	path := filepath.Join(t.TempDir(), "rootfs.raw")
+	require.NoError(t, os.WriteFile(path, contents, 0o600))
+	file, err := os.OpenFile(path, os.O_RDWR, 0)
+	require.NoError(t, err)
+	defer file.Close()
+
+	var before unix.Stat_t
+	require.NoError(t, unix.Fstat(int(file.Fd()), &before))
+	digest := digestBytes(contents)
+	rememberVerifiedReflinkDigest(before, digest, "identity")
+	require.NoError(t, validateReflinkDigest(int(file.Fd()), before, digest, "identity"))
+
+	// Avoid depending on one filesystem timestamp tick while still proving that
+	// size alone cannot preserve the process-local verification shortcut.
+	time.Sleep(time.Millisecond)
+	_, err = file.WriteAt(tampered, 0)
+	require.NoError(t, err)
+	require.NoError(t, file.Sync())
+	var after unix.Stat_t
+	require.NoError(t, unix.Fstat(int(file.Fd()), &after))
+	require.Equal(t, before.Size, after.Size)
+	require.NotEqual(t, before.Ctim, after.Ctim, "same-size tamper must change the inode fingerprint")
+	require.ErrorContains(t, validateReflinkDigest(int(file.Fd()), after, digest, "identity"), "digest does not match")
+}
+
