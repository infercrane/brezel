--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/nbd/pool_backpressure_test.go
@@ -0,0 +1,70 @@
+//go:build linux
+
+package nbd
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/bits-and-blooms/bitset"
+	"github.com/stretchr/testify/require"
+)
+
+func saturatedTestPool(slots uint) *DevicePool {
+	used := bitset.New(slots)
+	used.SetAll()
+	return &DevicePool{
+		done:         make(chan struct{}),
+		slotReleased: make(chan struct{}, 1),
+		usedSlots:    used,
+		slots:        make(chan DeviceSlot, slots),
+	}
+}
+
+func TestSaturatedPoolWaitsForReleaseSignalWithoutPolling(t *testing.T) {
+	pool := saturatedTestPool(128)
+	require.True(t, pool.allSlotsReserved())
+
+	done := make(chan bool, 1)
+	go func() { done <- pool.waitForSlotRelease(t.Context()) }()
+
+	select {
+	case released := <-done:
+		t.Fatalf("saturated pool returned without capacity: released=%v", released)
+	case <-time.After(20 * time.Millisecond):
+	}
+
+	pool.mu.Lock()
+	pool.usedSlots.Clear(127)
+	pool.mu.Unlock()
+	pool.notifySlotReleased()
+	require.True(t, <-done)
+	require.False(t, pool.allSlotsReserved())
+}
+
+func TestSaturatedPoolBackpressureHonorsCancelAndClose(t *testing.T) {
+	t.Run("cancel", func(t *testing.T) {
+		pool := saturatedTestPool(128)
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		require.False(t, pool.waitForSlotRelease(ctx))
+	})
+
+	t.Run("close", func(t *testing.T) {
+		pool := saturatedTestPool(128)
+		close(pool.done)
+		require.False(t, pool.waitForSlotRelease(t.Context()))
+	})
+}
+
+func TestReleaseNotificationsCoalesceWithoutBlocking(t *testing.T) {
+	pool := saturatedTestPool(128)
+
+	for i := 0; i < 128; i++ {
+		pool.notifySlotReleased()
+	}
+	require.Len(t, pool.slotReleased, 1)
+	require.True(t, pool.waitForSlotRelease(t.Context()))
+	require.Empty(t, pool.slotReleased)
+}
