diff --git a/packages/orchestrator/pkg/sandbox/guest_swap_test.go b/packages/orchestrator/pkg/sandbox/guest_swap_test.go
new file mode 100644
index 0000000..25ef3c4
--- /dev/null
+++ b/packages/orchestrator/pkg/sandbox/guest_swap_test.go
@@ -0,0 +1,49 @@
+//go:build linux
+
+package sandbox
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestEnsureGuestSwapWithRunner(t *testing.T) {
+	t.Parallel()
+
+	var gotTimeout time.Duration
+	var gotScript string
+	err := ensureGuestSwapWithRunner(t.Context(), func(_ context.Context, timeout time.Duration, script string) (int32, error) {
+		gotTimeout = timeout
+		gotScript = script
+
+		return 0, nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, guestSwapActivationTimeout, gotTimeout)
+	require.Contains(t, gotScript, "swapfile=/var/lib/brezel/swapfile")
+	require.Contains(t, gotScript, `/sbin/swapon "$swapfile"`)
+	require.Contains(t, gotScript, "/proc/swaps")
+}
+
+func TestEnsureGuestSwapWithRunnerFailsClosed(t *testing.T) {
+	t.Parallel()
+
+	t.Run("transport", func(t *testing.T) {
+		want := errors.New("envd unavailable")
+		err := ensureGuestSwapWithRunner(t.Context(), func(context.Context, time.Duration, string) (int32, error) {
+			return -1, want
+		})
+		require.ErrorIs(t, err, want)
+	})
+
+	t.Run("non-zero exit", func(t *testing.T) {
+		err := ensureGuestSwapWithRunner(t.Context(), func(context.Context, time.Duration, string) (int32, error) {
+			return 1, nil
+		})
+		require.EqualError(t, err, "activate guest swap reserve: command exited with code 1")
+	})
+}
