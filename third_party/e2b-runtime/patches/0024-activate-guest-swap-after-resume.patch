diff --git a/packages/orchestrator/pkg/sandbox/reclaim.go b/packages/orchestrator/pkg/sandbox/reclaim.go
index a5d3018..f221581 100644
--- a/packages/orchestrator/pkg/sandbox/reclaim.go
