@@ -320,6 +320,46 @@ func (s *Sandbox) runGuestShellCommand(ctx context.Context, timeout time.Duratio
 	return exitCode, nil
 }
 
+const guestSwapActivationTimeout = 3 * time.Second
+
+const guestSwapActivationScript = `
+swapfile=/var/lib/brezel/swapfile
+if [ ! -e "$swapfile" ]; then
+	exit 0
+fi
+if [ ! -f "$swapfile" ] || [ ! -x /sbin/swapon ]; then
+	exit 1
+fi
+if ! awk -v file="$swapfile" 'NR > 1 && $1 == file { found=1 } END { exit !found }' /proc/swaps; then
+	/sbin/swapon "$swapfile"
+fi
+awk -v file="$swapfile" 'NR > 1 && $1 == file { found=1 } END { exit !found }' /proc/swaps
+`
+
+type guestSwapCommandRunner func(context.Context, time.Duration, string) (int32, error)
+
+// ensureGuestSwap activates the optional Brezel-owned swap reserve after a
+// snapshot resume or guest reboot. Firecracker restores guest memory before it
+// attaches the writable root block device, so the kernel's restored swap table
+// cannot safely retain the file-backed block-device registration. The swapfile
+// is prepared and validated while the immutable template is built; each fresh
+// kernel must register it again before the sandbox is marked routable.
+func (s *Sandbox) ensureGuestSwap(ctx context.Context) error {
+	return ensureGuestSwapWithRunner(ctx, s.runGuestShellCommand)
+}
+
+func ensureGuestSwapWithRunner(ctx context.Context, run guestSwapCommandRunner) error {
+	exitCode, err := run(ctx, guestSwapActivationTimeout, guestSwapActivationScript)
+	if err != nil {
+		return fmt.Errorf("activate guest swap reserve: %w", err)
+	}
+	if exitCode != 0 {
+		return fmt.Errorf("activate guest swap reserve: command exited with code %d", exitCode)
+	}
+
+	return nil
+}
