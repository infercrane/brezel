@@ -0,0 +1,74 @@
+package placement
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	"github.com/e2b-dev/infra/packages/api/internal/api"
+	"github.com/e2b-dev/infra/packages/api/internal/orchestrator/nodemanager"
+)
+
+func TestResourceExhaustedRetryDelayIsPositiveBoundedAndJittered(t *testing.T) {
+	t.Parallel()
+
+	for _, refusal := range []int{0, 1, 2, 3, 8, 64} {
+		delay := resourceExhaustedRetryDelay("sbx-a", refusal)
+		require.Positive(t, delay)
+		require.LessOrEqual(t, delay, resourceExhaustedBackoffMax)
+	}
+
+	require.NotEqual(t,
+		resourceExhaustedRetryDelay("sbx-a", 3),
+		resourceExhaustedRetryDelay("sbx-b", 3),
+	)
+}
+
+func TestResourceExhaustedRetryStopsOnCancellation(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	require.False(t, waitForResourceExhaustedRetry(ctx, "sbx-cancelled", 64))
+}
+
+func TestResourceExhaustedPlacementDoesNotHotSpin(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+
+	var calls atomic.Int64
+	node := nodemanager.NewTestNode("node-exhausted", api.NodeStatusReady, 0, 8)
+	node.SetSandboxClient(&nodemanager.MockSandboxClientCustom{CreateFunc: func() error {
+		calls.Add(1)
+
+		return status.Error(codes.ResourceExhausted, "no start capacity")
+	}})
+	algorithm := stubAlgorithm{choose: func(map[string]struct{}) (*nodemanager.Node, error) {
+		return node, nil
+	}}
+	waits := 0
+	waitForRetry := func(_ context.Context, sandboxID string, refusal int) bool {
+		waits++
+		require.Equal(t, "sbx-exhausted", sandboxID)
+		require.Equal(t, waits, refusal)
+		if refusal == 3 {
+			cancel()
+
+			return false
+		}
+
+		return true
+	}
+	result, err := placeSandboxWithResourceExhaustedWait(ctx, algorithm, []*nodemanager.Node{node}, node, testSbxRequest("sbx-exhausted"), CPURequirement{}, FeatureRequirement{}, false, nil, waitForRetry)
+	require.Error(t, err)
+	require.True(t, result.TimedOut)
+	require.Nil(t, result.WarmedNode)
+	require.Equal(t, int64(3), calls.Load(), "every refusal must pass through the bounded waiter")
+	require.Equal(t, 3, waits)
+}
