 func (s *Server) refreshStartingSandboxesLimit(ctx context.Context) {
+	// A non-zero local limit is an operator-owned capacity boundary. Do not let
+	// a remote feature-flag refresh silently resize it after the node starts.
+	if s.config.MaxStartingInstancesPerNode > 0 {
+		return
+	}
+
 	ticker := time.NewTicker(startingSandboxesLimitRefreshInterval)
 	defer ticker.Stop()
 
