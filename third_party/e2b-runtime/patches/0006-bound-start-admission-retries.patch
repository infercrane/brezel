 	}
 }
 
+func resolveStartingSandboxesLimit(ctx context.Context, config cfg.Config, flags *featureflags.Client) int {
+	if config.MaxStartingInstancesPerNode > 0 {
+		return config.MaxStartingInstancesPerNode
+	}
+
+	return flags.IntFlag(ctx, featureflags.MaxStartingInstancesPerNode)
+}
+
 func (s *Server) updateMaxSandboxesLimit(ctx context.Context) {
 	s.info.MaxSandboxes.Store(int64(s.featureFlags.IntFlag(ctx, featureflags.MaxSandboxesPerNode)))
 }
