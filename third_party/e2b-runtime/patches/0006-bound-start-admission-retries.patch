+func waitForResourceExhaustedRetry(ctx context.Context, sandboxID string, refusal int) bool {
+	timer := time.NewTimer(resourceExhaustedRetryDelay(sandboxID, refusal))
+	defer timer.Stop()
+
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
+
+// resourceExhaustedRetryDelay applies deterministic per-sandbox jitter to a
+// capped exponential backoff. This prevents a single exhausted node from
+// turning placement into a CPU and log hot loop while avoiding a synchronized
+// retry wave from callers that arrived together.
+func resourceExhaustedRetryDelay(sandboxID string, refusal int) time.Duration {
+	if refusal < 1 {
+		refusal = 1
+	}
+
+	delay := resourceExhaustedBackoffInitial
+	for i := 1; i < refusal && delay < resourceExhaustedBackoffMax; i++ {
+		delay *= 2
+		if delay > resourceExhaustedBackoffMax {
+			delay = resourceExhaustedBackoffMax
+		}
+	}
+
+	hash := fnv.New64a()
+	_, _ = hash.Write([]byte(sandboxID))
+	var refusalBytes [8]byte
+	for i := range refusalBytes {
+		refusalBytes[i] = byte(uint64(refusal) >> (8 * i))
+	}
+	_, _ = hash.Write(refusalBytes[:])
+
+	half := delay / 2
+	return half + time.Duration(hash.Sum64()%uint64(half+1))
+}
