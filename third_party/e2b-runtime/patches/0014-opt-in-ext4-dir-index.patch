+func TestExt4DirIndexCacheKey(t *testing.T) {
+	t.Parallel()
+
+	off := testLayerKey(ext4DirIndexContext(false))
+	on := testLayerKey(ext4DirIndexContext(true))
+
+	t.Run("off contributes nothing and keeps the legacy digest", func(t *testing.T) {
+		t.Parallel()
+
+		assert.Equal(t, legacyLayerKey(), off)
+	})
+
+	t.Run("on cannot reuse an image built off", func(t *testing.T) {
+		t.Parallel()
+
+		assert.NotEqual(t, off, on)
+		assert.Equal(t, cache.HashKeys(testIndexVersion, testProvisionVersion, "1024", testBaseSource, "ext4-dir-index:v1"), on)
+	})
+
+	t.Run("off again returns to the legacy digest", func(t *testing.T) {
+		t.Parallel()
+
+		assert.Equal(t, legacyLayerKey(), testLayerKey(ext4DirIndexContext(false)))
+	})
+
+	t.Run("a build from a template inherits the parent's filesystem", func(t *testing.T) {
+		t.Parallel()
+
+		assert.Equal(t,
+			testLayerKey(fromTemplate(ext4DirIndexContext(false))),
+			testLayerKey(fromTemplate(ext4DirIndexContext(true))),
+		)
+	})
+
+	t.Run("the rootfs options are independent cache-key contributions", func(t *testing.T) {
+		t.Parallel()
+
+		bothContext := envdMemoryContext(true, 4096)
+		bothContext.Rootfs.Ext4DirIndex = true
+
+		keys := []string{
