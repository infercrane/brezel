+// BuildExt4DirIndexForTemplate reports whether an operator explicitly selected
+// this immutable template identity. Matching is exact: normalization here
+// would let a typo silently affect a different build than the operator named.
+func (c BuilderConfig) BuildExt4DirIndexForTemplate(templateID string) bool {
+	if c.BuildExt4DirIndexTemplateIDs == "" {
+		return false
+	}
+
+	for _, configured := range strings.Split(c.BuildExt4DirIndexTemplateIDs, ",") {
+		if configured == templateID {
+			return true
+		}
+	}
+
+	return false
+}
+
+func validateBuildExt4DirIndexTemplateIDs(raw string) error {
+	if raw == "" {
+		return nil
+	}
+
+	seen := make(map[string]struct{})
+	for _, templateID := range strings.Split(raw, ",") {
+		if templateID == "" || strings.TrimSpace(templateID) != templateID {
+			return fmt.Errorf("BUILD_EXT4_DIR_INDEX_TEMPLATE_IDS must be a comma-separated list of non-empty exact template IDs without whitespace")
+		}
+		if _, exists := seen[templateID]; exists {
+			return fmt.Errorf("BUILD_EXT4_DIR_INDEX_TEMPLATE_IDS contains duplicate template ID %q", templateID)
+		}
+		seen[templateID] = struct{}{}
+	}
+
+	return nil
+}
+
