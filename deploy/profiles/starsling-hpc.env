# Exact resource and artifact profile for the public Starsling HPC sandbox
# benchmark. The benchmark target is 4 vCPU, 8 GiB RAM, and at least 40 GiB of
# writable disk. Keep the upstream workload, tool versions, and pass counts in
# the Starsling repository; this file controls only Brezel's sandbox shape and
# immutable guest artifact.
BREZEL_ENGINE_BASE_TEMPLATE_SOURCE_IMAGE=ghcr.io/starslingdev/sandbox-benchmarks-toolchain@sha256:2ffc10a1ffb3cf24aca001a20ce6cb75f57c57f0280dfb934ca4089d37a3d70d
BREZEL_ENGINE_BASE_TEMPLATE_NAME=starsling-hpc-v8
BREZEL_GUEST_VCPUS=4
BREZEL_GUEST_MEMORY_MIB=8192
BREZEL_GUEST_SWAP_MIB=0
# E2B's builder treats this as minimum free space after the image build. ext4
# metadata can leave the observed value slightly below the request, so retain
# 1 GiB of headroom over the benchmark's 40 GiB disk gate.
BREZEL_GUEST_MIN_FREE_DISK_MIB=41984
BREZEL_GUEST_MAX_FREE_DISK_MIB=45056

# Run two replicas at a time on the 16-thread/60-GiB Scaleway host. This keeps
# eight logical CPUs and more than 36 GiB of RAM outside the guests for the
# VMM, NBD workers, networking, databases, and host page cache.
BREZEL_MAX_ACTIVE_SANDBOXES_TOTAL=2
BREZEL_MAX_ACTIVE_SANDBOXES_PER_PROJECT=2
BREZEL_ENGINE_MAX_STARTING_SANDBOXES=2
BREZEL_LIFECYCLE_HEADROOM_SANDBOXES=1
BREZEL_ENGINE_NETWORK_NEW_SLOTS=8
BREZEL_ENGINE_NETWORK_REUSED_SLOTS=8
BREZEL_ENGINE_NBD_POOL_SIZE=128
BREZEL_MIN_READY_NETWORK_SLOTS=8
BREZEL_ENGINE_HUGEPAGES=12288
BREZEL_MIN_SYSTEM_MEMORY_MIB=8192
BREZEL_MIN_SYSTEM_CPUS=8
BREZEL_ENGINE_FIRECRACKER_SMT=false
BREZEL_ENGINE_FIRECRACKER_EXCLUSIVE_CPU_TOPOLOGY=false
