# One large sandbox for ComputeSDK DAX. Startup is outside the DAX timer; this
# profile gives the measured command the required guest CPU, memory, writable
# root, package-manager access, and network capacity without reserving 100
# large guests. Requires an x86-64 KVM host with at least 40 GiB RAM.
# The upstream benchmark always installs the compiler toolchain and respects an
# existing Node executable. This immutable official Node image is therefore a
# useful general agent-development base rather than benchmark-specific cached
# state: no OpenCode source, Bun binary, package cache, or benchmark dependency
# is present in the template.
BREZEL_ENGINE_BASE_TEMPLATE_SOURCE_IMAGE=node:24.14.1-bookworm@sha256:80fc934952c8f1b2b4d39907af7211f8a9fff1a4c2cf673fb49099292c251cec
BREZEL_GUEST_VCPUS=8
BREZEL_GUEST_MEMORY_MIB=16384
# The engine's minimum is a pre-format growth target. ext4 metadata consumes a
# few hundred MiB, while DAX requires at least 16 GiB visible through df(1).
# Reserve 1 GiB of formatting headroom so the guest-visible contract is stable.
BREZEL_GUEST_MIN_FREE_DISK_MIB=17408
BREZEL_GUEST_MAX_FREE_DISK_MIB=25600
BREZEL_MAX_ACTIVE_SANDBOXES_TOTAL=1
BREZEL_MAX_ACTIVE_SANDBOXES_PER_PROJECT=1
BREZEL_ENGINE_MAX_STARTING_SANDBOXES=1
BREZEL_LIFECYCLE_HEADROOM_SANDBOXES=1
BREZEL_ENGINE_NETWORK_NEW_SLOTS=4
BREZEL_ENGINE_NETWORK_REUSED_SLOTS=4
BREZEL_ENGINE_NBD_POOL_SIZE=128
BREZEL_MIN_READY_NETWORK_SLOTS=4
BREZEL_ENGINE_HUGEPAGES=16384
BREZEL_MIN_SYSTEM_MEMORY_MIB=8192
