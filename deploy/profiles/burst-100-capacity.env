# Functional capacity profile for 100 simultaneous command-ready 2-vCPU,
# 512-MiB sandboxes. This proves capacity and cleanup; it is not a claim that
# all 100 cold starts complete at leaderboard latency. Requires at least 60 GiB
# RAM plus CPU and NVMe sized for the intended tail-latency target.
BREZEL_GUEST_VCPUS=2
BREZEL_GUEST_MEMORY_MIB=512
BREZEL_GUEST_MIN_FREE_DISK_MIB=512
BREZEL_GUEST_MAX_FREE_DISK_MIB=25600
BREZEL_MAX_ACTIVE_SANDBOXES_TOTAL=100
BREZEL_MAX_ACTIVE_SANDBOXES_PER_PROJECT=100
# Qualification on a 32-vCPU nested-KVM host showed that 32 concurrent starts
# increased tail latency and introduced command-stream failures. Keep two host
# vCPUs of scheduling headroom per admitted Firecracker start.
BREZEL_ENGINE_MAX_STARTING_SANDBOXES=16
BREZEL_LIFECYCLE_HEADROOM_SANDBOXES=4
BREZEL_ENGINE_NETWORK_NEW_SLOTS=128
BREZEL_ENGINE_NETWORK_REUSED_SLOTS=128
BREZEL_ENGINE_NBD_POOL_SIZE=128
BREZEL_MIN_READY_NETWORK_SLOTS=100
BREZEL_ENGINE_HUGEPAGES=26624
BREZEL_MIN_SYSTEM_MEMORY_MIB=8192
