# Controlled storage candidate for the public Starsling HPC benchmark on the
# qualified 8-core/16-thread host. It differs from the isolated CPU profile
# only by using four kernel NBD queues per guest root device. Keep it separate
# so the single-queue baseline and candidate remain independently reproducible.
BREZEL_ENGINE_BASE_TEMPLATE_SOURCE_IMAGE=ghcr.io/starslingdev/sandbox-benchmarks-toolchain@sha256:2ffc10a1ffb3cf24aca001a20ce6cb75f57c57f0280dfb934ca4089d37a3d70d
BREZEL_ENGINE_BASE_TEMPLATE_NAME=starsling-hpc-v8
BREZEL_GUEST_VCPUS=4
BREZEL_GUEST_MEMORY_MIB=8192
BREZEL_GUEST_SWAP_MIB=0
BREZEL_GUEST_MIN_FREE_DISK_MIB=41984
BREZEL_GUEST_MAX_FREE_DISK_MIB=45056

BREZEL_MAX_ACTIVE_SANDBOXES_TOTAL=1
BREZEL_MAX_ACTIVE_SANDBOXES_PER_PROJECT=1
BREZEL_ENGINE_MAX_STARTING_SANDBOXES=1
BREZEL_LIFECYCLE_HEADROOM_SANDBOXES=1
BREZEL_ENGINE_NETWORK_NEW_SLOTS=4
BREZEL_ENGINE_NETWORK_REUSED_SLOTS=4
BREZEL_ENGINE_NBD_POOL_SIZE=128
BREZEL_ENGINE_NBD_CONNECTIONS_PER_DEVICE=4
BREZEL_MIN_READY_NETWORK_SLOTS=4
BREZEL_ENGINE_HUGEPAGES=8192
BREZEL_MIN_SYSTEM_MEMORY_MIB=8192
BREZEL_MIN_SYSTEM_CPUS=8

BREZEL_ENGINE_FIRECRACKER_SMT=false
BREZEL_ENGINE_FIRECRACKER_EXCLUSIVE_CPU_TOPOLOGY=true
BREZEL_ENGINE_FIRECRACKER_CPUSET_CPUS=1-5,9-13
BREZEL_ENGINE_FIRECRACKER_CPUSET_MEMS=0
BREZEL_ENGINE_FIRECRACKER_VCPU_CPUS=1,2,3,5
BREZEL_ENGINE_FIRECRACKER_VMM_CPUS=4,12
